          "mimeType": "image/jpeg",
          "license": "CC BY-SA 3.0",
          "artist": "Tagishsimon",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Tyne_Bridge_-_Newcastle_Upon_Tyne_-_England_-_2004-08-14.jpg",
