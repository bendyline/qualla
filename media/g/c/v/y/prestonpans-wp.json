          "mimeType": "image/jpeg",
          "license": "CC BY-SA 3.0",
          "artist": "David Monniaux",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Edinburgh_Arthur_Seat_dsc06165.jpg",
