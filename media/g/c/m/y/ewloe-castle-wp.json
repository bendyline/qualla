        {
          "path": "_m/g/c/m/y/chester-wp/chester-cathedral-ext-hamilton.jpg",
          "filename": "Chester Cathedral ext Hamilton 001.JPG",
          "caption": "Chester Cathedral, England. The cathedral seen from the south-east looking towards the choir, right, with the Lady Chapel projecting, extreme right, and the south transept, left. The Lady Chapel is in the Early English (or Lancet) Gothic style, marked by the simple windows. The choir is in the late Geometric Decorated Gothic style. The South transept has Flowing Decorated windows in the aisle, and Perpendicular Gothic windows in the clerestory. The friable Red Sandstone building was heavily restored in the 19th century.",
          "alt": "Chester Cathedral, England. The cathedral seen from the south-east looking towards the choir, right, with the Lady Chapel projecting, extreme right, and the south transept, left. The Lady Chapel is in the Early English (or Lancet) Gothic style, marked by the simple windows. The choir is in the late Geometric Decorated Gothic style. The South transept has Flowing Decorated windows in the aisle, and Perpendicular Gothic windows in the clerestory. The friable Red Sandstone building was heavily restored in the 19th century.",
          "width": 2880,
          "height": 2160,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 3.0",
          "artist": "Stephen Hamilton",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Chester_Cathedral_ext_Hamilton_001.JPG",
          "sourceType": "poi",
