        {
          "path": "_m/g/c/w/f/thackray-museum-of-medicine-wp/lucy-baldwin-obstetric-analges.jpg",
          "filename": "Lucy Baldwin Obstetric Analgesia Apparatus.jpg",
          "caption": "Lucy Baldwin Apparatus for Obstetric Analgesia. circa 1970. Manufactured by BOC. Formerly used at the Princess Royal Infirmary at Huddersfield.  Now on display in the Thackray Medical Museum, Leeds. Used to supply an adjustable mixture of oxygen and nitrous oxide for inhalation by mothers giving birth in order to provide pain relief. The two gas cylinders fitted in the brackets below.  A hose attached to a mask was connected to the central spigot.  The lever around this was moved to vary the mixture between 70% N2O / 30% O2 to 100% O2.",
          "alt": "Lucy Baldwin Apparatus for Obstetric Analgesia. circa 1970. Manufactured by BOC. Formerly used at the Princess Royal Infirmary at Huddersfield.  Now on display in the Thackray Medical Museum, Leeds. Used to supply an adjustable mixture of oxygen and nitrous oxide for inhalation by mothers giving birth in order to provide pain relief. The two gas cylinders fitted in the brackets below.  A hose attached to a mask was connected to the central spigot.  The lever around this was moved to vary the mixture between 70% N2O / 30% O2 to 100% O2.",
          "width": 795,
          "height": 1994,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 4.0",
          "artist": "Chemical Engineer",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Lucy_Baldwin_Obstetric_Analgesia_Apparatus.jpg",
