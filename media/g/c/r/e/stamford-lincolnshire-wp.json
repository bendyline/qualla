          "width": 3648,
          "height": 2736,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 2.0",
          "artist": "Michael Trolove",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Stamford_town_scape_-_geograph.org.uk_-_1737389.jpg",
