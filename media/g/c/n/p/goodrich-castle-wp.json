        {
          "path": "_m/g/c/n/p/goodrich-castle-wp/13th-century-goodrich-castle.jpg",
          "filename": "13th century Goodrich Castle.jpg",
          "caption": "A castle has stood here since the 11th century, but most of what remains was the work of William de Valence, Henry III’s half-brother, in the late 13th century. His castle survived little altered until 1646, when Parliamentarians besieged it during the Civil War. Its Royalist garrison surrendered after a two-month siege. A locally-made cannon called Roaring Meg was used to bombard the garrison into submission. The only surviving mortar from the Civil War, it is now on display in the castle courtyard.",
          "alt": "A castle has stood here since the 11th century, but most of what remains was the work of William de Valence, Henry III’s half-brother, in the late 13th century. His castle survived little altered until 1646, when Parliamentarians besieged it during the Civil War. Its Royalist garrison surrendered after a two-month siege. A locally-made cannon called Roaring Meg was used to bombard the garrison into submission. The only surviving mortar from the Civil War, it is now on display in the castle courtyard.",
          "width": 1800,
          "height": 1201,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 4.0",
          "artist": "David James",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:13th_century_Goodrich_Castle.jpg",
          "sourceType": "commons-category",
          "sourceArticleId": "goodrich-castle-wp",
          "sourceGeohash4": "gcnp",
          "smallPath": "_m/g/c/n/p/goodrich-castle-wp/13th-century-goodrich-castle-small.webp"
        },
        {
