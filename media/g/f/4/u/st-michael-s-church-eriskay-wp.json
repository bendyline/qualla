        {
          "path": "_m/g/f/4/u/st-michael-s-church-eriskay-wp/st-michael-s-of-the-sea-geogra.jpg",
          "filename": "St Michael's of the Sea - geograph.org.uk - 1357198.jpg",
          "caption": "St Michael's of the Sea. This view shows the rounded end of the church 1357166.  The church at Bowmore on Islay is completely round - so that \"the de'il may not hide in the corners\": I don't know if the same principle applies here, or whether a rounded end is more able to cope with gales - there is a hand-rail all the way around the building from here to the main door, which hints at the strength of the winter winds.",
          "alt": "St Michael's of the Sea. This view shows the rounded end of the church 1357166.  The church at Bowmore on Islay is completely round - so that \"the de'il may not hide in the corners\": I don't know if the same principle applies here, or whether a rounded end is more able to cope with gales - there is a hand-rail all the way around the building from here to the main door, which hints at the strength of the winter winds.",
          "width": 640,
          "height": 480,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 2.0",
          "artist": "Barbara Carr",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:St_Michael%27s_of_the_Sea_-_geograph.org.uk_-_1357198.jpg",
          "sourceType": "commons-category",
          "sourceArticleId": "st-michael-s-church-eriskay-wp",
          "sourceGeohash4": "gf4u",
