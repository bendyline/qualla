        {
          "path": "_m/f/8/4/k/fort-beausejour-wp/fort-beausejour-fort-cumberlan.jpg",
          "filename": "Fort Beauséjour - Fort Cumberland National Historic Site.jpg",
          "caption": "Fort Beauséjour (French pronunciation: ​[fɔʁ boseʒuʁ]) is a large five-bastioned star fort on the Isthmus of Chignecto, a neck of land connecting present-day New Brunswick with Nova Scotia, Canada. The site was strategically important in Acadia, a French colony that included parts of what is now Quebec, The Maritimes, and northern Maine. It was built by the French from 1751 to 1752. It was surrendered to the British in 1755 after the Battle of Fort Beauséjour and renamed Fort Cumberland.",
          "alt": "Fort Beauséjour (French pronunciation: ​[fɔʁ boseʒuʁ]) is a large five-bastioned star fort on the Isthmus of Chignecto, a neck of land connecting present-day New Brunswick with Nova Scotia, Canada. The site was strategically important in Acadia, a French colony that included parts of what is now Quebec, The Maritimes, and northern Maine. It was built by the French from 1751 to 1752. It was surrendered to the British in 1755 after the Battle of Fort Beauséjour and renamed Fort Cumberland.",
          "width": 4032,
          "height": 3024,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 4.0",
          "artist": "Shawn M. Kent",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Fort_Beaus%C3%A9jour_-_Fort_Cumberland_National_Historic_Site.jpg",
