          "license": "CC BY-SA 4.0",
          "artist": "Pierre5018",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Premi%C3%A8re_messe_chant%C3%A9e_sur_les_bords_de_la_rivi%C3%A8re_des_Prairies.jpg",
