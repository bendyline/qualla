          "height": 1993,
          "mimeType": "image/jpeg",
          "license": "CC BY 2.0",
          "artist": "Ninara from Helsinki, Finland",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Mausoleum_of_Omar_Khayy%C3%A1m.jpg",
