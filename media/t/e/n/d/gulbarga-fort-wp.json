          "license": "CC BY-SA 4.0",
          "artist": "Kiranpawar3210",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Balahisar_bastion_for_cannon_located_center_of_the_fort.jpg",
          "sourceType": "core",
