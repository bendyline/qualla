        {
          "path": "_m/9/y/u/w/kansas-city-power-and-light-building-wp/power-and-light-building.jpg",
          "filename": "Power and Light Building.jpg",
          "caption": "Built in 1931, it was for 3 decades the tallest building built west of the Mississippi River, it is an iconic part of Kansas City's skyline and is the ideal display of art deco style architecture with it's intricate details and extravagant interior. For decades it was the headquarters of KCP&amp;L (now Evergy) which was and has been the primary electric company in the KCMO metropolitan area. They since have moved their HQ to the nearby One Kansas City Place; but the Power and Light building was renovated into luxury apartments and illuminates different colors every night and special colors for holidays such as Halloween and Christmas.",
          "alt": "Built in 1931, it was for 3 decades the tallest building built west of the Mississippi River, it is an iconic part of Kansas City's skyline and is the ideal display of art deco style architecture with it's intricate details and extravagant interior. For decades it was the headquarters of KCP&amp;L (now Evergy) which was and has been the primary electric company in the KCMO metropolitan area. They since have moved their HQ to the nearby One Kansas City Place; but the Power and Light building was renovated into luxury apartments and illuminates different colors every night and special colors for holidays such as Halloween and Christmas.",
          "width": 587,
          "height": 731,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 4.0",
          "artist": "Noah Bohland",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Power_and_Light_Building.jpg",
          "sourceType": "commons-category",
          "sourceArticleId": "kansas-city-power-and-light-building-wp",
          "sourceGeohash4": "9yuw",
