          "license": "CC BY-SA 4.0",
          "artist": "Micah hainline",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Memorial_to_the_Confederate_Dead_(Jefferson_Barracks)_-_Front.jpg",
