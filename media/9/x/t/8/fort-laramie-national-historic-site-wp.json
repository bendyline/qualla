        {
          "path": "_m/9/x/t/8/fort-laramie-national-historic-site-wp/founded-william-sublet.jpg",
          "filename": "Alfred Jacob Miller - Fort Laramie - Walters 37194049.jpg",
          "caption": "Founded by William Sublette and Robert Campbell, Fort Laramie lay at the crossroads of an old north-south Indian trail and what became known as the Oregon Trail. Called Fort Laramie because of the nearby Laramie Mountains and the Laramie Fork of the North Platte River, the post was approximately 150 feet square, according to Miller, with bastions at the diagonal corners. Miller's paintings are the only known visual records of the fort, because the original fort was torn down in 1840 before any other artist had traveled the Oregon Trail; it was replaced with another structure, located perhaps on the same site in 1841.",
          "alt": "Founded by William Sublette and Robert Campbell, Fort Laramie lay at the crossroads of an old north-south Indian trail and what became known as the Oregon Trail. Called Fort Laramie because of the nearby Laramie Mountains and the Laramie Fork of the North Platte River, the post was approximately 150 feet square, according to Miller, with bastions at the diagonal corners. Miller's paintings are the only known visual records of the fort, because the original fort was torn down in 1840 before any other artist had traveled the Oregon Trail; it was replaced with another structure, located perhaps on the same site in 1841.",
          "width": 1800,
          "height": 1309,
          "mimeType": "image/jpeg",
          "license": "Public domain",
          "artist": "Alfred Jacob Miller",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Alfred_Jacob_Miller_-_Fort_Laramie_-_Walters_37194049.jpg",
          "sourceType": "core",
