        {
          "path": "_m/w/9/z/h/iloilo-customs-house-wp/port-of-iloilo.jpg",
          "filename": "Port of Iloilo.jpg",
          "caption": "Since at least 1855, the Port has served international shipping, handling sugar and fertilizer shipments for the international market. The opening of the Port of Iloilo to the world market by Queen Isabella II of Spain on September 29, 1855,[3][4] replaced the disappearing textile industry. When the Suez Canal opened in 1869, trade with Europe, particularly the United Kingdom, became much easier. Muelle Loney, the quay that runs along the Iloilo River, is named after Nicholas Loney, the consul for the United Kingdom.",
          "alt": "Since at least 1855, the Port has served international shipping, handling sugar and fertilizer shipments for the international market. The opening of the Port of Iloilo to the world market by Queen Isabella II of Spain on September 29, 1855,[3][4] replaced the disappearing textile industry. When the Suez Canal opened in 1869, trade with Europe, particularly the United Kingdom, became much easier. Muelle Loney, the quay that runs along the Iloilo River, is named after Nicholas Loney, the consul for the United Kingdom.",
          "width": 6016,
          "height": 4000,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 4.0",
          "artist": "Rencell D.",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Port_of_Iloilo.jpg",
