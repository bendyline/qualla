          "license": "CC BY-SA 4.0",
          "artist": "Justicelogic",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Green_Island_Lighthouse-2.jpg",
          "sourceType": "commons-category",
          "sourceArticleId": "ludao-lighthouse-wp",
          "sourceGeohash4": "wsn3",
          "mediumPath": "_m/w/s/n/3/ludao-lighthouse-wp/green-island-lighthouse-2-medium.webp",
