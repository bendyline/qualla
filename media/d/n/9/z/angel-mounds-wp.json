        {
          "path": "_m/d/n/9/z/angel-mounds-wp/open-plaza-at-angel-mounds-shs.jpg",
          "filename": "Open plaza at Angel Mounds SHS.jpg",
          "caption": "An open plaza near the eastern edge of the Angel Mounds State Historic Site (SHS), located along Pollack Avenue between Evansville and Newburgh in the U.S. state of Indiana.  While most of the site lies in Vanderburgh County, the eastern edge lies across the county line in Warrick County.  One of the most important Middle Mississippian sites and the center of the culture's Angel phase, the site has been declared a National Historic Landmark because of its outstanding archaeological significance.  The hay bales are a fundraising effort for the SHS: because most of the site is tall grass, the SHS periodically cuts the grass, bales it as hay, and sells it.",
          "alt": "An open plaza near the eastern edge of the Angel Mounds State Historic Site (SHS), located along Pollack Avenue between Evansville and Newburgh in the U.S. state of Indiana.  While most of the site lies in Vanderburgh County, the eastern edge lies across the county line in Warrick County.  One of the most important Middle Mississippian sites and the center of the culture's Angel phase, the site has been declared a National Historic Landmark because of its outstanding archaeological significance.  The hay bales are a fundraising effort for the SHS: because most of the site is tall grass, the SHS periodically cuts the grass, bales it as hay, and sells it.",
          "width": 2816,
          "height": 1584,
          "mimeType": "image/jpeg",
          "license": "Public domain",
