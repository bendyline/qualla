        {
          "path": "_m/d/n/q/v/old-salem-wp/salem-tavern-located-s.jpg",
          "filename": "Salem Tavern, Old Salem, NC.jpg",
          "caption": "This is the Salem Tavern, located on South Main Street in the Old Salem Historic District in Winston-Salem, North Carolina.  Constructed in 1784, the building was where George Washington stayed during his Southern Tour in 1791.  It is a contributing building in the Old Salem Historic District, listed on the National Register of Historic Places and as a National Landmark Historic District in 1966.",
          "alt": "This is the Salem Tavern, located on South Main Street in the Old Salem Historic District in Winston-Salem, North Carolina.  Constructed in 1784, the building was where George Washington stayed during his Southern Tour in 1791.  It is a contributing building in the Old Salem Historic District, listed on the National Register of Historic Places and as a National Landmark Historic District in 1966.",
          "width": 4032,
          "height": 3024,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 4.0",
          "artist": "Warren LeMay",
