        {
          "path": "_m/d/n/f/0/santa-claus-indiana-wp/santa-claus-aster.jpg",
          "filename": "Santa Claus (ASTER).jpg",
          "caption": "The towns of Santa Claus, GA, (top) and Santa Claus, IN (bottom) are shown in these two ASTER images. They are the only 2 Santa Claus towns with post offices and zip codes, although there are 11 towns with this name in the US. Santa Claus, GA is located in Toombs County, and has a population of 237. Santa Claus, IN is located in Spencer County, and has a population of 2041. Its name was accepted by the Post Office in 1856. Both images cover an area of 10.5 x 6.75 km. They were acquired on June 16, 2001 and July 3, 2000. They are located at 32.2 north latitude, 82.3 west longitude; and 38.1 north latitude, 86.9 west longitude.",
          "alt": "The towns of Santa Claus, GA, (top) and Santa Claus, IN (bottom) are shown in these two ASTER images. They are the only 2 Santa Claus towns with post offices and zip codes, although there are 11 towns with this name in the US. Santa Claus, GA is located in Toombs County, and has a population of 237. Santa Claus, IN is located in Spencer County, and has a population of 2041. Its name was accepted by the Post Office in 1856. Both images cover an area of 10.5 x 6.75 km. They were acquired on June 16, 2001 and July 3, 2000. They are located at 32.2 north latitude, 82.3 west longitude; and 38.1 north latitude, 86.9 west longitude.",
          "width": 700,
          "height": 910,
          "mimeType": "image/jpeg",
          "license": "Public domain",
          "artist": "NASA/METI/AIST/Japan Space Systems, and U.S./Japan ASTER Science Team",
