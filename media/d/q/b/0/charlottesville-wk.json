          "license": "CC BY 4.0",
          "artist": "Sarah Stierch",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:First_Baptist_Church_West_Main_Street,_Charlottesville,_VA_-_Sarah_Stierch.jpg",
          "sourceType": "core",
