        {
          "path": "_m/q/q/w/e/kotagede-wp/masjid-gedhe-mataram-kotagede.jpg",
          "filename": "Masjid Gedhe Mataram Kotagede.jpg",
          "caption": "The Mataram Kotagede Gedhe Mosque is one of the oldest mosques in existence\nin the Yogyakarta area, and is a mosque heritage of the Mataram Kingdom. In\nIn the Kotagede area of ​​Yogyakarta, there are still historical relics that save\ninformation about the Mataram Kingdom. One of the historical places in Kotagede is\nThe Mataram Gedhe Mosque which was built during the Mataram Kingdom era in\n1640. The Great Mosque of Mataram was built by Sultan Agung who worked together\n\nwith people who still adhere to Hinduism and Buddhism.",
          "alt": "The Mataram Kotagede Gedhe Mosque is one of the oldest mosques in existence\nin the Yogyakarta area, and is a mosque heritage of the Mataram Kingdom. In\nIn the Kotagede area of ​​Yogyakarta, there are still historical relics that save\ninformation about the Mataram Kingdom. One of the historical places in Kotagede is\nThe Mataram Gedhe Mosque which was built during the Mataram Kingdom era in\n1640. The Great Mosque of Mataram was built by Sultan Agung who worked together\n\nwith people who still adhere to Hinduism and Buddhism.",
          "width": 4500,
          "height": 3000,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 4.0",
          "artist": "Arry gunawan",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Masjid_Gedhe_Mataram_Kotagede.jpg",
          "sourceType": "commons-category",
          "sourceArticleId": "kotagede-wp",
          "sourceGeohash4": "qqwe",
          "mediumPath": "_m/q/q/w/e/kotagede-wp/masjid-gedhe-mataram-kotagede-medium.webp",
          "smallPath": "_m/q/q/w/e/kotagede-wp/masjid-gedhe-mataram-kotagede-small.webp"
        },
        {
          "path": "_m/q/q/w/e/kotagede-wp/makam-raja-mataram-kotagede.jpg",
          "filename": "Makam Raja Mataram Kotagede.jpg",
          "caption": "The Kotagede tomb is a legacy of the splendor of the 16th century Mataram Kingdom. The buildings around this tomb still have the architectural characteristics of Hindu culture. Important figures buried here include: Sultan Hadiwiijaya, Ki Gede Pemanahan, Panembahan Senopati, and his family.",
          "alt": "The Kotagede tomb is a legacy of the splendor of the 16th century Mataram Kingdom. The buildings around this tomb still have the architectural characteristics of Hindu culture. Important figures buried here include: Sultan Hadiwiijaya, Ki Gede Pemanahan, Panembahan Senopati, and his family.",
          "width": 4500,
          "height": 3001,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 4.0",
          "artist": "Arry gunawan",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Makam_Raja_Mataram_Kotagede.jpg",
          "sourceType": "commons-category",
