        {
          "path": "_m/q/q/w/7/tugu-yogyakarta-wp/tugu-jogja.jpg",
          "filename": "Tugu Jogja.jpg",
          "caption": "Tugu Pal Putih yang dulunya disebut Tugu Golong Gilig adalah ikon yang sangat terkenal di Yogyakarta. Tugu ini memiliki makna semangat persatuan antara rakyat dengan rajanya. Lokasinya berada di Cokrodiningratan, Jetis, Yogyakarta, DIY.",
          "alt": "Tugu Pal Putih yang dulunya disebut Tugu Golong Gilig adalah ikon yang sangat terkenal di Yogyakarta. Tugu ini memiliki makna semangat persatuan antara rakyat dengan rajanya. Lokasinya berada di Cokrodiningratan, Jetis, Yogyakarta, DIY.",
          "width": 6000,
          "height": 3376,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 4.0",
          "artist": "Zen Artwork",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Tugu_Jogja.jpg",
          "sourceType": "commons-category",
          "sourceArticleId": "tugu-yogyakarta-wp",
          "sourceGeohash4": "qqw7",
          "mediumPath": "_m/q/q/w/7/tugu-yogyakarta-wp/tugu-jogja-medium.webp",
