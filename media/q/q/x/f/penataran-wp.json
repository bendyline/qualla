        {
          "path": "_m/q/q/x/f/penataran-wp/candi-panataran-java-1285.jpg",
          "filename": "Candi Panataran, Java 1285.jpg",
          "caption": "Candi Panataran, in the highlands of East Java, was built over a\nperiod of more than two and a half centuries; its earliest associated date is 1197, and the latest is 1454. This view looks southeast, towards the Pendopo (\"Entrance\") Terrace that fronts the grounds.",
          "alt": "Candi Panataran, in the highlands of East Java, was built over a\nperiod of more than two and a half centuries; its earliest associated date is 1197, and the latest is 1454. This view looks southeast, towards the Pendopo (\"Entrance\") Terrace that fronts the grounds.",
          "width": 3072,
          "height": 2304,
          "mimeType": "image/jpeg",
          "license": "CC BY-SA 4.0",
          "artist": "Michael Gunther",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Candi_Panataran,_Java_1285.jpg",
