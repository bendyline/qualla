        {
          "path": "_m/u/1/7/0/girl-with-a-pearl-earring-wp/vermeergirlwithpearlearring-va.jpg",
          "filename": "VermeerGirlwithPearlEarring-VanHareEffect3DExample.jpg",
          "caption": "Two identical images of the famous Vermeer painting, Girl with a Pearl Earring, painted c. 1665, are placed side-by-side to demonstrate the Van Hare Effect and how it can be used to reinterpret artworks. The a 2D painting can be artificially perceived as if it is stereoscopic, giving artificial depth. In this case, a dimensional mistake is uncovered -- the girl's neck is not properly painted in the correct position for artificial depth. This is an error in the original painting that heretofore typically escapes notice when seen by a common viewer's eye. Once the error is recognized through application of the Van Hare Effect, it becomes easily recognized even when viewing normally as a single image.",
          "alt": "Two identical images of the famous Vermeer painting, Girl with a Pearl Earring, painted c. 1665, are placed side-by-side to demonstrate the Van Hare Effect and how it can be used to reinterpret artworks. The a 2D painting can be artificially perceived as if it is stereoscopic, giving artificial depth. In this case, a dimensional mistake is uncovered -- the girl's neck is not properly painted in the correct position for artificial depth. This is an error in the original painting that heretofore typically escapes notice when seen by a common viewer's eye. Once the error is recognized through application of the Van Hare Effect, it becomes easily recognized even when viewing normally as a single image.",
          "width": 1800,
          "height": 1074,
          "mimeType": "image/jpeg",
          "license": "Public domain",
          "artist": "Johannes Vermeer",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:VermeerGirlwithPearlEarring-VanHareEffect3DExample.jpg",
          "sourceType": "commons-category",
          "sourceArticleId": "girl-with-a-pearl-earring-wp",
          "sourceGeohash4": "u170",
          "smallPath": "_m/u/1/7/0/girl-with-a-pearl-earring-wp/vermeergirlwithpearlearring-va-small.webp"
