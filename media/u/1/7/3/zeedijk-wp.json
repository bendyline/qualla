          "mimeType": "image/jpeg",
          "license": "CC BY 2.0",
          "artist": "Bert Kaufmann from Roermond, Netherlands",
          "sourceUrl": "https://commons.wikimedia.org/wiki/File:Amsterdam_-_Oudezijds_Kolk_(Explore)_(4912497357).jpg",
          "sourceType": "commons-category",
