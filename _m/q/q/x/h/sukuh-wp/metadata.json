      "filename": "Keris Relief at Sukuh Temple.jpg",
      "title": "File:Keris Relief at Sukuh Temple.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/8f/Keris_Relief_at_Sukuh_Temple.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Keris_Relief_at_Sukuh_Temple.jpg",
