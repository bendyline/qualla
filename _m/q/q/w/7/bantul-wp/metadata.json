      "filename": "Perahu Berdiri.jpg",
      "title": "File:Perahu Berdiri.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/6/65/Perahu_Berdiri.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
