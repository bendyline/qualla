      "filename": "Buddha Seguntang Palembang.jpg",
      "title": "File:Buddha Seguntang Palembang.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/3/3c/Buddha_Seguntang_Palembang.jpg",
