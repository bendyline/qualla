    {
      "filename": "Taman Nasional Gunung Rinjani.jpg",
      "title": "File:Taman Nasional Gunung Rinjani.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/f/f4/Taman_Nasional_Gunung_Rinjani.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Taman_Nasional_Gunung_Rinjani.jpg",
      "width": 5184,
