      "sourceArticleId": "madura-wp",
      "sourceGeohash4": "qw8x",
      "mediumPath": "_m/q/w/8/x/madura-wp/batik-madura-medium.webp",
      "smallPath": "_m/q/w/8/x/madura-wp/batik-madura-small.webp"
    },
