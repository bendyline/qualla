      "filename": "Batik Madura.jpg",
      "title": "File:Batik Madura.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/f/fa/Batik_Madura.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Batik_Madura.jpg",
      "width": 3504,
