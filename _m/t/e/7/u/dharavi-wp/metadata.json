    {
      "filename": "Pottery unit in Dharavi, Mumbai.jpg",
      "title": "File:Pottery unit in Dharavi, Mumbai.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/9/9f/Pottery_unit_in_Dharavi%2C_Mumbai.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Pottery_unit_in_Dharavi,_Mumbai.jpg",
      "width": 1138,
      "height": 757,
      "mime": "image/jpeg",
