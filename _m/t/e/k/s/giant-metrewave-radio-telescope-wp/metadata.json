      "filename": "Crab Nebula.jpg",
      "title": "File:Crab Nebula.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/0/00/Crab_Nebula.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Crab_Nebula.jpg",
      "width": 3864,
