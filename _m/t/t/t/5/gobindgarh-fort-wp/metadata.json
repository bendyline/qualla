      "smallPath": "_m/t/t/t/5/gobindgarh-fort-wp/no-not-wine-the-mannequin-is-s-small.webp"
    },
    {
      "filename": "Exhibit showing early Sikh coinage (38936347991).jpg",
      "title": "File:Exhibit showing early Sikh coinage (38936347991).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/c/cc/Exhibit_showing_early_Sikh_coinage_%2838936347991%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Exhibit_showing_early_Sikh_coinage_(38936347991).jpg",
