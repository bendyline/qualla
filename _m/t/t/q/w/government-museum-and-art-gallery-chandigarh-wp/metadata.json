    {
      "filename": "A rather industrial looking building of the Chandigarh Museum (43554594424).jpg",
      "title": "File:A rather industrial looking building of the Chandigarh Museum (43554594424).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/a4/A_rather_industrial_looking_building_of_the_Chandigarh_Museum_%2843554594424%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:A_rather_industrial_looking_building_of_the_Chandigarh_Museum_(43554594424).jpg",
