    {
      "filename": "20160130 Sri Lanka 4290 Galle sRGB (25650030142).jpg",
      "title": "File:20160130 Sri Lanka 4290 Galle sRGB (25650030142).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/b/bd/20160130_Sri_Lanka_4290_Galle_sRGB_%2825650030142%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:20160130_Sri_Lanka_4290_Galle_sRGB_(25650030142).jpg",
