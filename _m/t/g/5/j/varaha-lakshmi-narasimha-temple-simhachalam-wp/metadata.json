    {
      "filename": "Sri Varaha Lakshmi Narasimha temple, Simhachalam.jpg",
      "title": "File:Sri Varaha Lakshmi Narasimha temple, Simhachalam.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/7/7f/Sri_Varaha_Lakshmi_Narasimha_temple%2C_Simhachalam.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Sri_Varaha_Lakshmi_Narasimha_temple,_Simhachalam.jpg",
