    {
      "filename": "Herakles-Verethragna at Behistun (4000748339).jpg",
      "title": "File:Herakles-Verethragna at Behistun (4000748339).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/10/Herakles-Verethragna_at_Behistun_%284000748339%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Herakles-Verethragna_at_Behistun_(4000748339).jpg",
      "width": 3648,
