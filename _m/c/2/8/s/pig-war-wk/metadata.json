    {
      "filename": "Mt Baker through Obstruction Pass.jpg",
      "title": "File:Mt Baker through Obstruction Pass.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/0/0d/Mt_Baker_through_Obstruction_Pass.jpg",
