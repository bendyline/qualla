      "filename": "Seattle - Occidental and Yesler - 1884.jpg",
      "title": "File:Seattle - Occidental and Yesler - 1884.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/e/e0/Seattle_-_Occidental_and_Yesler_-_1884.jpg",
