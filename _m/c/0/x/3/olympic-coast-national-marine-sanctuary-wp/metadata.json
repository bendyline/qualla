    {
      "filename": "OCNMS - sea otter (27837694295).jpg",
      "title": "File:OCNMS - sea otter (27837694295).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/5/5e/OCNMS_-_sea_otter_%2827837694295%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:OCNMS_-_sea_otter_(27837694295).jpg",
      "width": 1781,
      "height": 1187,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "National Marine Sanctuaries",
      "description": "Did you know that sea otters were once completely eradicated from the Washington coast? A few dozen were reintroduced in 1969 and 1970, and since then that population has grown to more than 1,000 individuals -- like this mama otter and her pup. \n\nPhoto Credit: NOAA",
      "dateCreated": "2016-06-22 10:17",
      "sourceType": "commons-category",
      "sourceArticleId": "olympic-coast-national-marine-sanctuary-wp",
      "sourceGeohash4": "c0x3",
      "smallPath": "_m/c/0/x/3/olympic-coast-national-marine-sanctuary-wp/ocnms-sea-otter-27837694295-small.webp"
    },
    {
      "filename": "OCNMS - otter ecosystem survey - Chris Harvey diver - Nick Tolimeri NOAA NWFSC (27226605133).jpg",
      "title": "File:OCNMS - otter ecosystem survey - Chris Harvey diver - Nick Tolimeri NOAA NWFSC (27226605133).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/b/b6/OCNMS_-_otter_ecosystem_survey_-_Chris_Harvey_diver_-_Nick_Tolimeri_NOAA_NWFSC_%2827226605133%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:OCNMS_-_otter_ecosystem_survey_-_Chris_Harvey_diver_-_Nick_Tolimeri_NOAA_NWFSC_(27226605133).jpg",
      "width": 1920,
      "height": 1080,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "National Marine Sanctuaries",
      "description": "The sea otter is considered a \"keystone\" species in kelp forest ecosystems, meaning their contribution to the health of the ecosystem is disproportionate to their numbers. In the early 1900s, the northern sea otter (Enhudra lutris kenyoni) was hunted to local extinction along the Olympic Coast of Washington. But since 59 sea otters were reintroduced in 1969 and 1970, the population has grown to approximately 1,600 individuals! In the summer of 2015, researchers -- like Chris Harvey, diving here -- surveyed Olympic Coast National Marine Sanctuary to see just how the reintroduction of these furry mammals has affected the sanctuary ecosystem. \n\nPhoto Credit: Nick Tolimeri/NOAA NWFSC",
      "dateCreated": "2015-08-14 08:34",
      "sourceType": "commons-category",
      "sourceArticleId": "olympic-coast-national-marine-sanctuary-wp",
      "sourceGeohash4": "c0x3",
      "mediumPath": "_m/c/0/x/3/olympic-coast-national-marine-sanctuary-wp/ocnms-otter-ecosystem-survey-c-medium.webp",
      "smallPath": "_m/c/0/x/3/olympic-coast-national-marine-sanctuary-wp/ocnms-otter-ecosystem-survey-c-small.webp"
    },
