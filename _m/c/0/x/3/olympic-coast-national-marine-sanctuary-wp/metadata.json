    {
      "filename": "OCNMS - Rialto Beach (27979360215).jpg",
      "title": "File:OCNMS - Rialto Beach (27979360215).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/4/45/OCNMS_-_Rialto_Beach_%2827979360215%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:OCNMS_-_Rialto_Beach_(27979360215).jpg",
      "width": 3430,
      "height": 2267,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "National Marine Sanctuaries",
      "description": "Take a mental vacation with this gorgeous view of Rialto Beach, in Olympic National Park bordering Olympic Coast National Marine Sanctuary. The tide pools of the Olympic Coast support all manner of organisms, from sea stars to urchins, and anemones to small fish! \n\nPhoto Credit: Karlyn Langjahr/NOAA",
