      "filename": "Panoplosaurus 055.JPG",
      "title": "File:Panoplosaurus 055.JPG",
      "url": "https://upload.wikimedia.org/wikipedia/commons/0/09/Panoplosaurus_055.JPG",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Panoplosaurus_055.JPG",
