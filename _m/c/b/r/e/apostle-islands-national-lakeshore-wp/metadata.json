    {
      "filename": "Apostle Islands National Lakeshore, Wisconsin (bff1aceb-6c8f-4954-94c8-8a294325090e).jpg",
      "title": "File:Apostle Islands National Lakeshore, Wisconsin (bff1aceb-6c8f-4954-94c8-8a294325090e).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/2/29/Apostle_Islands_National_Lakeshore%2C_Wisconsin_%28bff1aceb-6c8f-4954-94c8-8a294325090e%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Apostle_Islands_National_Lakeshore,_Wisconsin_(bff1aceb-6c8f-4954-94c8-8a294325090e).jpg",
      "width": 3072,
      "height": 2048,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "NPS staff",
      "description": "Headquarters sign.\nThese islands in Lake Superior have been inhabited by early Native Americans, pioneer farmers, commercial fishermen, lighthouse keepers and their families.  They host the nation's finest collection of lighthouses.  The beauty of the islands are enhanced by the area?s geology. Colorful precambrian sandstone have eroded into interesting cliff formations, including sea caves, and there is a highly diverse collection of sandscapes, including sandspits, cuspate forelands, tombolos, a barrier spit, and numerous beaches. These sandscapes are among the most pristine left in the Great Lakes region.\nKeywords: apis; apostle islands; Lakes; Islands; Natural preserves; Lighthouses",
      "dateCreated": "Taken on 4 December 2003",
      "sourceType": "commons-category",
      "sourceArticleId": "apostle-islands-national-lakeshore-wp",
      "sourceGeohash4": "cbre",
      "mediumPath": "_m/c/b/r/e/apostle-islands-national-lakeshore-wp/apostle-islands-national-lakes-medium.webp",
      "smallPath": "_m/c/b/r/e/apostle-islands-national-lakeshore-wp/apostle-islands-national-lakes-small.webp"
    },
