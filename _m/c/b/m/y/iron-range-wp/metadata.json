      "filename": "Gogebic Iron Range Sign - Saxon Wisconsin.jpg",
      "title": "File:Gogebic Iron Range Sign - Saxon Wisconsin.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/ab/Gogebic_Iron_Range_Sign_-_Saxon_Wisconsin.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Gogebic_Iron_Range_Sign_-_Saxon_Wisconsin.jpg",
      "width": 7952,
      "height": 5304,
