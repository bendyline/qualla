    {
      "filename": "Aloha Tower Honolulu. (10754440616).jpg",
      "title": "File:Aloha Tower Honolulu. (10754440616).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/dc/Aloha_Tower_Honolulu._%2810754440616%29.jpg",
