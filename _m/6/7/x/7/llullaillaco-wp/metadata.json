    {
      "filename": "Parque Nacional Llullaillaco.jpg",
      "title": "File:Parque Nacional Llullaillaco.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/b/b3/Parque_Nacional_Llullaillaco.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Parque_Nacional_Llullaillaco.jpg",
      "width": 4113,
      "height": 4113,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "Robert Simmon",
      "description": "Natural-colour image of Parque Nacional Llullaillaco. Some snow and ice linger on the slopes of Llullaillaco, but little vegetation appears in this landscape. The clearest patch of green occurs in a lake east of the park. This landscape is a combination of mostly bare peaks and salt pans—the large, nearly white areas south and west of the volcano.",
      "dateCreated": "2003-02-04",
      "sourceType": "commons-category",
      "sourceArticleId": "llullaillaco-national-park-wk",
