      "filename": "Hotel Eden - La Falda - Argentina 01.jpg",
      "title": "File:Hotel Eden - La Falda - Argentina 01.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/9/9a/Hotel_Eden_-_La_Falda_-_Argentina_01.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Hotel_Eden_-_La_Falda_-_Argentina_01.jpg",
      "width": 2272,
