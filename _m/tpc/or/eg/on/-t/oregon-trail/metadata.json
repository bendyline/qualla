      "dateCreated": "<p>21 November 2008 (original upload date)<br>\n</p>\n(<span lang=\"en\" dir=\"ltr\">Original text: <i><bdi lang=\"\">July 18, 2007</bdi></i></span>)",
      "sourceType": "sibling",
