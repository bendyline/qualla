    {
      "filename": "File, Asuán, Egipto, 2022-04-01, DD 144.jpg",
      "title": "File:File, Asuán, Egipto, 2022-04-01, DD 144.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/8c/File%2C_Asu%C3%A1n%2C_Egipto%2C_2022-04-01%2C_DD_144.jpg",
