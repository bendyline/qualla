    },
    {
      "filename": "United States Mint Philadelphia.jpg",
      "title": "File:United States Mint Philadelphia.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/e/e4/United_States_Mint_Philadelphia.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:United_States_Mint_Philadelphia.jpg",
      "width": 3264,
      "height": 2245,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "Beyond My Ken",
      "description": "The fourth building of the United States Mint in Philadelphia, at 151 North Independence Mall East (N. 5th St.) in the Old City neighborhood, was completed in 1969 and was designed by Vincent G. Kling. It was the world's largest mint when it was built and held that distinction as of January 2009.  The full-block building is bounded by Arch Street (south), N. 5th Street (west), Race Street (north) and N. 4th Street (east)",
      "dateCreated": "2013-04-21",
      "sourceType": "sibling",
      "sourceArticleId": "independence-national-historical-park",
