    {
      "filename": "Saint Petersburg, Russia (47944856703).jpg",
      "title": "File:Saint Petersburg, Russia (47944856703).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/5/53/Saint_Petersburg%2C_Russia_%2847944856703%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Saint_Petersburg,_Russia_(47944856703).jpg",
