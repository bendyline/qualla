    {
      "filename": "Thetford Castle - geograph.org.uk - 2377651.jpg",
      "title": "File:Thetford Castle - geograph.org.uk - 2377651.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/8b/Thetford_Castle_-_geograph.org.uk_-_2377651.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Thetford_Castle_-_geograph.org.uk_-_2377651.jpg",
      "width": 800,
