    {
      "filename": "Entrance to War Graves Plot - geograph.org.uk - 752853.jpg",
      "title": "File:Entrance to War Graves Plot - geograph.org.uk - 752853.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/83/Entrance_to_War_Graves_Plot_-_geograph.org.uk_-_752853.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Entrance_to_War_Graves_Plot_-_geograph.org.uk_-_752853.jpg",
