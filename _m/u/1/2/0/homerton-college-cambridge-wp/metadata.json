    {
      "filename": "Homerton College - The Great Hall.jpg",
      "title": "File:Homerton College - The Great Hall.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/b/b2/Homerton_College_-_The_Great_Hall.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Homerton_College_-_The_Great_Hall.jpg",
      "width": 3531,
