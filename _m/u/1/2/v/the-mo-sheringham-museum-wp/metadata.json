    {
      "filename": "The Mo, Sheringham 1825200.jpg",
      "title": "File:The Mo, Sheringham 1825200.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/df/The_Mo%2C_Sheringham_1825200.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:The_Mo,_Sheringham_1825200.jpg",
      "width": 640,
