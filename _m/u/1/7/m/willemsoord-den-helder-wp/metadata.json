      "filename": "WLM - Lumperjack - Nieuwe Dok (Dok 2), Willemsoord.jpg",
      "title": "File:WLM - Lumperjack - Nieuwe Dok (Dok 2), Willemsoord.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/f/fd/WLM_-_Lumperjack_-_Nieuwe_Dok_%28Dok_2%29%2C_Willemsoord.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:WLM_-_Lumperjack_-_Nieuwe_Dok_(Dok_2),_Willemsoord.jpg",
      "width": 1024,
      "height": 682,
      "mime": "image/jpeg",
