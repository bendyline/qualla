      "filename": "Van Abbe Museum Eindhoven.jpg",
      "title": "File:Van Abbe Museum Eindhoven.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/af/Van_Abbe_Museum_Eindhoven.jpg",
