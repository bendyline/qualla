    {
      "filename": "Belgium-6598 - Palace (13935156270).jpg",
      "title": "File:Belgium-6598 - Palace (13935156270).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/0/09/Belgium-6598_-_Palace_%2813935156270%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Belgium-6598_-_Palace_(13935156270).jpg",
      "width": 6000,
