      "filename": "Pylon 380 kV Sint-Niklaas BE 2016.jpg",
      "title": "File:Pylon 380 kV Sint-Niklaas BE 2016.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/6/68/Pylon_380_kV_Sint-Niklaas_BE_2016.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Pylon_380_kV_Sint-Niklaas_BE_2016.jpg",
