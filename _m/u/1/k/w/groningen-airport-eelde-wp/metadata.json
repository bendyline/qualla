    {
      "filename": "'Fahrbereitschaft' vliegveld Eelde.jpg",
      "title": "File:'Fahrbereitschaft' vliegveld Eelde.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/d6/%27Fahrbereitschaft%27_vliegveld_Eelde.jpg",
