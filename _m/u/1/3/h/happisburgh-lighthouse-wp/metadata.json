    {
      "filename": "-2018-07-12 Happisburgh lighthouse, Norfolk.jpg",
      "title": "File:-2018-07-12 Happisburgh lighthouse, Norfolk.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/1a/-2018-07-12_Happisburgh_lighthouse%2C_Norfolk.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:-2018-07-12_Happisburgh_lighthouse,_Norfolk.jpg",
      "width": 1319,
