      "filename": "Børglumkloster Vendsyssel 1897.png",
      "title": "File:Børglumkloster Vendsyssel 1897.png",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/81/B%C3%B8rglumkloster_Vendsyssel_1897.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
