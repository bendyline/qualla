    {
      "filename": "Nuclear emulsion and its scanning.jpg",
      "title": "File:Nuclear emulsion and its scanning.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/2/28/Nuclear_emulsion_and_its_scanning.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Nuclear_emulsion_and_its_scanning.jpg",
