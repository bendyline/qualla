    {
      "filename": "Open plaza at Angel Mounds SHS.jpg",
      "title": "File:Open plaza at Angel Mounds SHS.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/0/02/Open_plaza_at_Angel_Mounds_SHS.jpg",
