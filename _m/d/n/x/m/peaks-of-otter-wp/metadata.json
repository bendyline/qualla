    {
      "filename": "Peaks of Otter Salamander (48909655753).jpg",
      "title": "File:Peaks of Otter Salamander (48909655753).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/d6/Peaks_of_Otter_Salamander_%2848909655753%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Peaks_of_Otter_Salamander_(48909655753).jpg",
      "width": 4032,
      "height": 3024,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "U. S. Fish and Wildlife Service - Northeast Region",
      "description": "Liberty University biology professor Norman Reichenbach holds a Peaks of Otter salamander. The species was first described in 1957 by Gordon Thurow. It is a slender, lungless woodland salamander that is dark brown with abundant brassy metallic spots or blotches. Adults grow up to nearly 2.5 inches and can live up to 10 years in the wild. Credit: Meagan Racey/USFWS",
      "dateCreated": "Taken on 9 October 2019, 12:27:13",
      "sourceType": "commons-category",
      "sourceArticleId": "peaks-of-otter-wp",
      "sourceGeohash4": "dnxm"
    },
    {
      "filename": "Peaks of Otter salamander (48910187301).jpg",
      "title": "File:Peaks of Otter salamander (48910187301).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/f/f0/Peaks_of_Otter_salamander_%2848910187301%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Peaks_of_Otter_salamander_(48910187301).jpg",
      "width": 4032,
      "height": 3024,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "U. S. Fish and Wildlife Service - Northeast Region",
      "description": "The Peaks of Otter salamander has no lungs, breathing entirely through the tissues in its mouth and skin. Preserving adequate tree cover to prevent the sun from drying soil and leaf litter is crucial as the salamander relies on adequate ground moisture to keep its skin moist enough to breathe and to forage successfully in the forest. Through a conservation agreement with U.S. Fish and Wildlife Service, U.S. Forest Service and National Park Service, timber harvest is managed to ensure habitat and canopy cover remain intact. Credit: Meagan Racey/USFWS",
      "dateCreated": "Taken on 9 October 2019, 12:11:38",
      "sourceType": "commons-category",
      "sourceArticleId": "peaks-of-otter-wp",
      "sourceGeohash4": "dnxm"
