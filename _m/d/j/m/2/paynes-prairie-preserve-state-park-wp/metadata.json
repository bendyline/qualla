    {
      "filename": "NB I-75; Paynes Prairie Rest Area; Unsponsored.jpg",
      "title": "File:NB I-75; Paynes Prairie Rest Area; Unsponsored.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/d6/NB_I-75%3B_Paynes_Prairie_Rest_Area%3B_Unsponsored.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
