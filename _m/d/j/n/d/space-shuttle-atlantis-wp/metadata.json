    {
      "filename": "KSC-95EC-0423.jpg",
      "title": "File:KSC-95EC-0423.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/8f/KSC-95EC-0423.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
