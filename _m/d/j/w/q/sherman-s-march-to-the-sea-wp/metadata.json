    {
      "filename": "20-05-027-indian-springs.jpg",
      "title": "File:20-05-027-indian-springs.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/dd/20-05-027-indian-springs.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
