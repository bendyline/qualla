      "sourceType": "commons-category",
      "sourceArticleId": "highland-park-ford-plant-wp",
      "sourceGeohash4": "dpsc",
      "mediumPath": "_m/d/p/s/c/highland-park-ford-plant-wp/ford-highland-park-manufacturi-medium.webp",
      "smallPath": "_m/d/p/s/c/highland-park-ford-plant-wp/ford-highland-park-manufacturi-small.webp"
    },
    {
      "filename": "Ford Highland Park Manufacturing Plant, Highland Park, Michigan - 20201213.jpg",
      "title": "File:Ford Highland Park Manufacturing Plant, Highland Park, Michigan - 20201213.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/83/Ford_Highland_Park_Manufacturing_Plant%2C_Highland_Park%2C_Michigan_-_20201213.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Ford_Highland_Park_Manufacturing_Plant,_Highland_Park,_Michigan_-_20201213.jpg",
      "width": 3809,
      "height": 2285,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "Andre Carrotflower",
      "description": "As seen in December 2020: the Ford Highland Park Manufacturing Plant in Highland Park, Michigan, where Henry Ford employed his innovative assembly line manufacturing process to mass-produce Model Ts at a rate of one every three minutes, making automobile ownership viable for the American middle class. Model Ts were built here from the building's opening in 1910 until the completion of Ford's much larger River Rouge plant in 1927, after which point the Highland Park facility was used to principally to manufacture tractor parts and, during World War II, tanks. The building ceased to be used for manufacturing in the 1980s and was last used by Ford as a storage facility for documents and artifacts destined for the Henry Ford Museum of American Innovation in Dearborn. It's been vacant since about 2011 and the subject of various redevelopment proposals since then.",
      "dateCreated": "2020-12-13 14:02:49",
      "sourceType": "commons-category",
      "sourceArticleId": "highland-park-ford-plant-wp",
      "sourceGeohash4": "dpsc",
      "mediumPath": "_m/d/p/s/c/highland-park-ford-plant-wp/ford-highland-park-manufacturi-1-medium.webp",
