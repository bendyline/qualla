    {
      "filename": "Historic Faro Los Morrillos de Cabo Rojo in Puerto Rico.jpg",
      "title": "File:Historic Faro Los Morrillos de Cabo Rojo in Puerto Rico.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/e/e3/Historic_Faro_Los_Morrillos_de_Cabo_Rojo_in_Puerto_Rico.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Historic_Faro_Los_Morrillos_de_Cabo_Rojo_in_Puerto_Rico.jpg",
      "width": 4032,
