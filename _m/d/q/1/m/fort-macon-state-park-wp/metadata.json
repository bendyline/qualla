    {
      "filename": "30 Pounder Parrott Rifle image 2.jpg",
      "title": "File:30 Pounder Parrott Rifle image 2.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/85/30_Pounder_Parrott_Rifle_image_2.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:30_Pounder_Parrott_Rifle_image_2.jpg",
      "width": 4608,
      "height": 3456,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "DrStew82",
      "description": "This is the informational marker that accompanies a 30 Pounder Parrott Rifle on display at Fort Macon State Park (near Atlantic Beach, NC). It was this type of rifled artillery that did extensive damage to the fort during the siege that took place here in the American Civil War. Weapons like this one demonstrated that \"hard\" (ie- stone or masonry) forts like Fort Macon were now obsolete and unable to withstand the fire of such weapons.",
      "dateCreated": "2018-05-30 22:57:37",
      "sourceType": "commons-category",
      "sourceArticleId": "fort-macon-state-park-wp",
      "sourceGeohash4": "dq1m",
      "mediumPath": "_m/d/q/1/m/fort-macon-state-park-wp/30-pounder-parrott-rifle-image-medium.jpg",
      "smallPath": "_m/d/q/1/m/fort-macon-state-park-wp/30-pounder-parrott-rifle-image-small.jpg"
    },
    {
      "filename": "Artillery damage at Fort Macon.jpg",
      "title": "File:Artillery damage at Fort Macon.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/df/Artillery_damage_at_Fort_Macon.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Artillery_damage_at_Fort_Macon.jpg",
      "width": 3456,
      "height": 4608,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "DrStew82",
      "description": "The crack in this ceiling resulted from artillery fire from Union forces in 1862. The room directly behind this was a powder magazine, which had been targeted by Union gunners. The brickwork of the fort was no match for the new 30-Pounder Parrott Rifles being used against it. Upon viewing this damage the fort's commander, Confederate Army Colonel Moses James White concluded it would be necessary to surrender the fort. This battle served to demonstrate the obsolescence brick and stone fortifications against rifled artillery. Fort Macon is located in Fort Macon State Park, near Atlantic Beach, NC",
      "dateCreated": "2018-05-30 23:38:42",
      "sourceType": "commons-category",
      "sourceArticleId": "fort-macon-state-park-wp",
      "sourceGeohash4": "dq1m",
      "mediumPath": "_m/d/q/1/m/fort-macon-state-park-wp/artillery-damage-at-fort-macon-medium.jpg",
      "smallPath": "_m/d/q/1/m/fort-macon-state-park-wp/artillery-damage-at-fort-macon-small.jpg"
    },
    {
      "filename": "Colonel Moses James White.jpg",
      "title": "File:Colonel Moses James White.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/5/53/Colonel_Moses_James_White.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Colonel_Moses_James_White.jpg",
      "width": 4608,
      "height": 3456,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "DrStew82",
      "description": "Photo of Confederate Army Colonel Moses James White, who was the commandant of Fort Macon during the period 1861-62. This picture and information marker is on display at Fort Macon. Fort Macon is located in Fort Macon State Park, near Atlantic Beach, NC.",
      "dateCreated": "2018-05-31 00:03:46",
      "sourceType": "commons-category",
      "sourceArticleId": "fort-macon-state-park-wp",
      "sourceGeohash4": "dq1m",
