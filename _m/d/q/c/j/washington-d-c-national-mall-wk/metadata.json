    {
      "filename": "Lincoln memorial seen from washington memorial.jpg",
      "title": "File:Lincoln memorial seen from washington memorial.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/a7/Lincoln_memorial_seen_from_washington_memorial.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Lincoln_memorial_seen_from_washington_memorial.jpg",
      "width": 2154,
      "height": 2353,
      "mime": "image/jpeg",
      "license": "CC BY-SA 3.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/3.0",
      "artist": "Ad Meskens",
      "credit": "Own work",
      "source": "Lincoln memorial seen from washington memorial",
      "description": "Part of the National Mall with World War II Memorial, reflectihg pool and Lincoln Memorial.\nThe Lincoln Memorial is a United States Presidential memorial built to honor the 16th President of the United States, Abraham Lincoln. \nThe Lincoln Memorial Reflecting Pool is the largest of Washington, D.C.'s reflecting pools. Located directly east of the Lincoln Memorial, it is a long, rectangular pool visible in many photographs of the Washington Monument. It is lined by walking paths and shade trees on both sides. It reflects both the Washington Monument and the Lincoln Memorial.\nThe U.S. National World War II Memorial is a National Memorial dedicated to Americans who served in the armed forces and as civilians during World War II. \n\nThe final design consists of 56 pillars, each 5 m tall, arranged in a semicircle around a plaza with two 13 m arches on opposite sides. Two-thirds of the 7.4-acre (30,000 m2) site is landscaping and water. Each pillar is inscribed with the name of one of the 48 U.S. states of 1945, as well as the District of Columbia, the Alaska Territory and Territory of Hawaii, the Commonwealth of the Philippines, Puerto Rico, Guam, American Samoa, and the U.S. Virgin Islands. The northern arch is inscribed with \"Atlantic\"; the southern one, \"Pacific.\"",
      "dateCreated": "Taken on 16 July 2007, 16:10 (according to <span lang=\"en\" dir=\"ltr\"><a href=\"https://en.wikipedia.org/wiki/Exif\" class=\"extiw\" title=\"en:Exif\">Exif</a></span> data)",
      "sourceType": "core",
      "sourceArticleId": "washington-d-c-national-mall-wk",
      "sourceGeohash4": "dqcj",
      "smallPath": "_m/d/q/c/j/washington-d-c-national-mall-wk/lincoln-memorial-seen-from-was-small.webp",
      "mediumPath": "_m/d/q/c/j/washington-d-c-national-mall-wk/lincoln-memorial-seen-from-was-medium.webp"
    },
