    {
      "filename": "Strand Bookstore.jpg",
      "title": "File:Strand Bookstore.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/f/fb/Strand_Bookstore.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Strand_Bookstore.jpg",
      "width": 2304,
      "height": 1443,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "Beyond My Ken",
      "description": "The Strand Bookstore, at 828 Broadway at the corner of East 12th Street in the East Village neighborhood of Manhattan, New York City, near Union Square, advertises that they have \"18 Miles of Books\".  When it was founded in 1927 on nearby Fourth Avenue, it was one of 48 bookstores along what was called \"Book Row\", which began in the 1890s, but did not survive into the 1980s. (Source: \"Strand History\" at the Strand Bookstore website)",
      "dateCreated": "Taken on 4 November 2011",
      "sourceType": "commons-category",
      "sourceArticleId": "strand-bookstore-wp",
      "sourceGeohash4": "dr5r",
      "mediumPath": "_m/d/r/5/r/strand-bookstore-wp/strand-bookstore-medium.webp",
      "smallPath": "_m/d/r/5/r/strand-bookstore-wp/strand-bookstore-small.webp"
    },
    {
      "filename": "Gay Talese 2006 by David Shankbone (4962834590).jpg",
      "title": "File:Gay Talese 2006 by David Shankbone (4962834590).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/4/4b/Gay_Talese_2006_by_David_Shankbone_%284962834590%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Gay_Talese_2006_by_David_Shankbone_(4962834590).jpg",
      "width": 1297,
      "height": 1265,
      "mime": "image/jpeg",
      "license": "CC BY 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/2.0",
      "artist": "David Shankbone from USA",
      "description": "This is one of my earliest photographs for my project, taken in August 2006.  At the famed Strand Bookstore, Gay Talese is a legend and I was nervous to be bold enough to take his portrait.  This would be the start of my series of authors.  \nI was milling about in the aisle next to the speaker's podium, and behind me he walked up.  He was so friendly, introduced himself, and I mumbled if I could take his photo.  He was happy to do so.  I took a few shots, and then he went to speak.  An encouraging first experience.\nIn 2007 I would sit with him at his kitchen table to discuss the awful state of American journalism.\nThis photo is included in my '100 People I Photographed for the Creative Commons' set of my favorites shots out of the thousands of people I have photographed.\n\n(About David Shankbone)",
      "dateCreated": "2007-09-07 23:16",
      "sourceType": "commons-category",
      "sourceArticleId": "strand-bookstore-wp",
      "sourceGeohash4": "dr5r",
      "smallPath": "_m/d/r/5/r/strand-bookstore-wp/gay-talese-2006-by-david-shank-small.webp"
    },
