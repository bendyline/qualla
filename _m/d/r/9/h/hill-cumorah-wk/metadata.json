      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "Andre Carrotflower",
      "description": "Looking northward along South Main Street in historic downtown Canandaigua, New York on a May 2021 evening. These buildings were listed on the National Register of Historic Places in 1984 as part of the Canandaigua Historic District.",
      "dateCreated": "Taken on 22 May 2021, 19:26:56",
      "sourceType": "commons-category",
      "sourceArticleId": "hill-cumorah-wk",
      "sourceGeohash4": "dr95",
      "mediumPath": "_m/d/r/9/5/hill-cumorah-wk/former-acme-supermarket-south--medium.webp",
      "smallPath": "_m/d/r/9/5/hill-cumorah-wk/former-acme-supermarket-south--small.webp"
