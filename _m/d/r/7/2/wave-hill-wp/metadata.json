    {
      "filename": "Wave Hill - 20220616 - 11 - pathway outside Glyndor.jpg",
      "title": "File:Wave Hill - 20220616 - 11 - pathway outside Glyndor.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/c/c2/Wave_Hill_-_20220616_-_11_-_pathway_outside_Glyndor.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Wave_Hill_-_20220616_-_11_-_pathway_outside_Glyndor.jpg",
      "width": 7808,
      "height": 3964,
