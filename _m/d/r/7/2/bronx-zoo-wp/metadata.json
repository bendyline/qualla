    {
      "filename": "Bronx Zoological Park - DPLA - 0810d730971bf313f10ec4cd0d521a5e.jpg",
      "title": "File:Bronx Zoological Park - DPLA - 0810d730971bf313f10ec4cd0d521a5e.jpg",
