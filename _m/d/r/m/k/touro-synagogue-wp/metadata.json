    {
      "filename": "Touro Synagogue, Newport, RI.jpg",
      "title": "File:Touro Synagogue, Newport, RI.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/d8/Touro_Synagogue%2C_Newport%2C_RI.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Touro_Synagogue,_Newport,_RI.jpg",
