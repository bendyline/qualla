    },
    {
      "filename": "Bandelier National Monument (32508415605).jpg",
      "title": "File:Bandelier National Monument (32508415605).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/12/Bandelier_National_Monument_%2832508415605%29.jpg",
