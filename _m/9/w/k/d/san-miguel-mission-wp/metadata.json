    {
      "filename": "San Miguel Mission Chapel- Santa Fe, New Mexico.jpg",
      "title": "File:San Miguel Mission Chapel- Santa Fe, New Mexico.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/7/73/San_Miguel_Mission_Chapel-_Santa_Fe%2C_New_Mexico.jpg",
