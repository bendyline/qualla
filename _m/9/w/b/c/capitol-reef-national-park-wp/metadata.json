      "filename": "Big Thomson Mesa, Capitol Reef National Park, Utah.jpg",
      "title": "File:Big Thomson Mesa, Capitol Reef National Park, Utah.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/a8/Big_Thomson_Mesa%2C_Capitol_Reef_National_Park%2C_Utah.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Big_Thomson_Mesa,_Capitol_Reef_National_Park,_Utah.jpg",
      "width": 4256,
