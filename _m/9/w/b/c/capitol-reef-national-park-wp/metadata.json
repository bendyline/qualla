    {
      "filename": "Capitol Reef from Dixie Forest - Flickr - brewbooks.jpg",
      "title": "File:Capitol Reef from Dixie Forest - Flickr - brewbooks.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/db/Capitol_Reef_from_Dixie_Forest_-_Flickr_-_brewbooks.jpg",
