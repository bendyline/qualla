    {
      "filename": "A Day at a Time (5832696774).jpg",
      "title": "File:A Day at a Time (5832696774).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/7/76/A_Day_at_a_Time_%285832696774%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
