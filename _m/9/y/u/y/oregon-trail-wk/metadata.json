    {
      "filename": "Alfred Jacob Miller - Cavalcade - Walters 371940199.jpg",
      "title": "File:Alfred Jacob Miller - Cavalcade - Walters 371940199.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/dd/Alfred_Jacob_Miller_-_Cavalcade_-_Walters_371940199.jpg",
