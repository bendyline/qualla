    {
      "filename": "Power and Light Building.jpg",
      "title": "File:Power and Light Building.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/9/9d/Power_and_Light_Building.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
