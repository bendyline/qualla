    {
      "filename": "PowerandLightBuilding (2).jpg",
      "title": "File:PowerandLightBuilding (2).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/1b/PowerandLightBuilding_%282%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:PowerandLightBuilding_(2).jpg",
