    },
    {
      "filename": "Willow poles on the Sacramento River (8465732741).jpg",
      "title": "File:Willow poles on the Sacramento River (8465732741).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/e/ee/Willow_poles_on_the_Sacramento_River_%288465732741%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
