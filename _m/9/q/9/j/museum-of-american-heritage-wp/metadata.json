      "filename": "Old-electric-bug-zapper.jpg",
      "title": "File:Old-electric-bug-zapper.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/a4/Old-electric-bug-zapper.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
