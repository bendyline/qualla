    {
      "filename": "Hotel St. Francis after the earthquake and fire.jpg",
      "title": "File:Hotel St. Francis after the earthquake and fire.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/12/Hotel_St._Francis_after_the_earthquake_and_fire.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
