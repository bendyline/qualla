    {
      "filename": "Luther Burbank Home and Gardens - Flickr - brewbooks.jpg",
      "title": "File:Luther Burbank Home and Gardens - Flickr - brewbooks.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/17/Luther_Burbank_Home_and_Gardens_-_Flickr_-_brewbooks.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
