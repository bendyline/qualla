      "filename": "Camarasaurus lentus Carnegie.jpg",
      "title": "File:Camarasaurus lentus Carnegie.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/3/33/Camarasaurus_lentus_Carnegie.jpg",
