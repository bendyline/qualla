    {
      "filename": "Alfred Jacob Miller - Fort Laramie - Walters 37194049.jpg",
      "title": "File:Alfred Jacob Miller - Fort Laramie - Walters 37194049.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/0/08/Alfred_Jacob_Miller_-_Fort_Laramie_-_Walters_37194049.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Alfred_Jacob_Miller_-_Fort_Laramie_-_Walters_37194049.jpg",
      "width": 1800,
      "height": 1309,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "Alfred Jacob Miller",
      "credit": "Walters Art Museum:  Home page  Info about artwork",
      "source": "Fort Laramie",
      "description": "Founded by William Sublette and Robert Campbell, Fort Laramie lay at the crossroads of an old north-south Indian trail and what became known as the Oregon Trail. Called Fort Laramie because of the nearby Laramie Mountains and the Laramie Fork of the North Platte River, the post was approximately 150 feet square, according to Miller, with bastions at the diagonal corners. Miller's paintings are the only known visual records of the fort, because the original fort was torn down in 1840 before any other artist had traveled the Oregon Trail; it was replaced with another structure, located perhaps on the same site in 1841.",
      "dateCreated": "between 1858 and 1860<div style=\"display: none;\">date QS:P571,+1850-00-00T00:00:00Z/7,P1319,+1858-00-00T00:00:00Z/9,P1326,+1860-00-00T00:00:00Z/9</div>",
