    {
      "filename": "Driskill Hotel, Austin, Texas Historical Marker (8511756246).jpg",
      "title": "File:Driskill Hotel, Austin, Texas Historical Marker (8511756246).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/c/c6/Driskill_Hotel%2C_Austin%2C_Texas_Historical_Marker_%288511756246%29.jpg",
