    {
      "filename": "Fuerza de Santa Isabel, Taytay, Palawan.jpg",
      "title": "File:Fuerza de Santa Isabel, Taytay, Palawan.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/18/Fuerza_de_Santa_Isabel%2C_Taytay%2C_Palawan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Fuerza_de_Santa_Isabel,_Taytay,_Palawan.jpg",
      "width": 1000,
      "height": 667,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "Celesteannar",
      "description": "Fuerza de Santa Isabel in the poblacion (village) of Taytay town, northern Palawan, was first constructed as a wood palisade in 1667 under the Augustinian Recollect Fathers. Now, it is one of the most visited tourist destinations in the northern part of the province.",
      "dateCreated": "2014-04-27 17:32:18",
      "sourceType": "commons-category",
      "sourceArticleId": "fort-santa-isabel-wp",
      "sourceGeohash4": "w9uv",
