      "filename": "Javellana Building of Calle Real in Iloilo City.jpg",
      "title": "File:Javellana Building of Calle Real in Iloilo City.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/0/0f/Javellana_Building_of_Calle_Real_in_Iloilo_City.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Javellana_Building_of_Calle_Real_in_Iloilo_City.jpg",
      "width": 6000,
