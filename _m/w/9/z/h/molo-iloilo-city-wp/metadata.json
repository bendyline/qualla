      "filename": "MOLO CHURCH 011.jpg",
      "title": "File:MOLO CHURCH 011.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/b/bc/MOLO_CHURCH_011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:MOLO_CHURCH_011.jpg",
      "width": 4608,
      "height": 3456,
      "mime": "image/jpeg",
