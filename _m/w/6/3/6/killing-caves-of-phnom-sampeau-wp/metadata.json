    },
    {
      "filename": "The adults killing field seen from down here (14266046689).jpg",
      "title": "File:The adults killing field seen from down here (14266046689).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/5/51/The_adults_killing_field_seen_from_down_here_%2814266046689%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:The_adults_killing_field_seen_from_down_here_(14266046689).jpg",
      "width": 2848,
      "height": 4288,
      "mime": "image/jpeg",
      "license": "CC BY 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/2.0",
      "artist": "shankar s. from Dubai, united arab emirates",
      "description": "We were in the cave now, and someone had managed to tie Khmer New Year flyers down that steep drop. That's quite a drop, I remarked. Yes, the adults were thrown down by the Khmer Rouge from up there, my guide informed me. Give me a break, I've not even recovered from the horror of the children murdering cave! And here I am standing at the bottom of a cave, the very spot where thousands of people have fallen to their heads. I'm standing on ground that has seen cracked skulls, broken limbs and bloodied bodies. Oh my god! (Battambang, Cambodia, Apr. 2014)",
      "dateCreated": "2014-04-01 00:00",
      "categories": [
        "CC-BY-2.0",
        "Flickr images reviewed by FlickreviewR 2",
        "Killing caves of Phnom Sampeau",
        "Photographs by shankar s."
      ],
      "sourceType": "commons-category",
