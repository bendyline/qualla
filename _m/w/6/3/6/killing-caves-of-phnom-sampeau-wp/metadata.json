    {
      "filename": "A closer view of the childrens' killing cave (14451326492).jpg",
      "title": "File:A closer view of the childrens' killing cave (14451326492).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/da/A_closer_view_of_the_childrens%27_killing_cave_%2814451326492%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:A_closer_view_of_the_childrens%27_killing_cave_(14451326492).jpg",
      "width": 4288,
      "height": 2848,
