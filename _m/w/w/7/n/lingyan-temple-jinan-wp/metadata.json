    {
      "filename": "Jinan 2009 1471.jpg",
      "title": "File:Jinan 2009 1471.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/0/0e/Jinan_2009_1471.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Jinan_2009_1471.jpg",
      "width": 2592,
