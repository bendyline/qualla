    {
      "filename": "Gold belt buckle from Western Han dynasty tomb Tianqi Mountain Xuzhou Jiangsu 2nd century BCE MH 02.jpg",
      "title": "File:Gold belt buckle from Western Han dynasty tomb Tianqi Mountain Xuzhou Jiangsu 2nd century BCE MH 02.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/7/7c/Gold_belt_buckle_from_Western_Han_dynasty_tomb_Tianqi_Mountain_Xuzhou_Jiangsu_2nd_century_BCE_MH_02.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Gold_belt_buckle_from_Western_Han_dynasty_tomb_Tianqi_Mountain_Xuzhou_Jiangsu_2nd_century_BCE_MH_02.jpg",
      "width": 4476,
