      "filename": "Chinese - Flask - Walters 491632.jpg",
      "title": "File:Chinese - Flask - Walters 491632.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/5/55/Chinese_-_Flask_-_Walters_491632.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
