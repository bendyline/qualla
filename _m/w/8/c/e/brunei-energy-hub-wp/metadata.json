    {
      "filename": "Royal Customs Wharf in Brunei Town 1961 02.jpg",
      "title": "File:Royal Customs Wharf in Brunei Town 1961 02.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/f/fb/Royal_Customs_Wharf_in_Brunei_Town_1961_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Royal_Customs_Wharf_in_Brunei_Town_1961_02.jpg",
      "width": 1548,
      "height": 1123,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "Government of Brunei",
      "description": "Approximately 5,000 people gathered at the Royal Customs Wharf in Brunei Town on the morning of 11th December 1961 to bid farewell with the message \"Selamat Berkhidmat kepada Tanah Air\" (\"Serve the Homeland Well\") to 195 future soldiers of the Brunei Malay Regiment.\nBefore the recruits departed from Brunei, they had the opportunity to shake hands with the Honourable Dato Setia Marsal bin Ma’un, the Chief Minister of Brunei. The Chief Minister delivered a speech offering valuable advice to the recruits at the gathering.\nFollowing this, Begawan Mudim Haji Adnan, the Kadhi of Brunei, recited a prayer for their safety, accompanied by the call to prayer (azan) by Mudim Haji Wasli.\n\nThese photographs were taken at the Royal Customs Wharf in Bandar Brunei before the future Brunei Malay Regiment recruits departed for Labuan. Another scene captured in Labuan on the evening of 11th December 1961 shows the recruits boarding the vessel Keningau to sail to Singapore.",
      "dateCreated": "1961-12-11",
      "sourceType": "commons-category",
      "sourceArticleId": "brunei-energy-hub-wp",
      "sourceGeohash4": "w8ce",
      "smallPath": "_m/w/8/c/e/brunei-energy-hub-wp/royal-customs-wharf-in-brunei--small.webp"
    },
