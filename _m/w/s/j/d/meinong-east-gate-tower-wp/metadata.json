    {
      "filename": "瀰濃東門樓.jpg",
      "title": "File:瀰濃東門樓.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/c/c0/%E7%80%B0%E6%BF%83%E6%9D%B1%E9%96%80%E6%A8%93.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:%E7%80%B0%E6%BF%83%E6%9D%B1%E9%96%80%E6%A8%93.jpg",
      "width": 1338,
      "height": 1600,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "WEI, WAN-CHEN（魏琬臻）",
      "description": "Bordering the Meinong River, Minong East Gate was the defense installation on the east side of Minong Village. The original date of construction is unknown, but it is alleged that the existing gate at the east entrance was upgraded in 1937 by local merchants and dignitaries. It had been destroyed during a resistance revolt against the Japanese rulers in 1895. During the Pacific War, a small construction was added to the top in which a large bell was hung to be used as an air-raid alarm, but both the construction and the bell were removed after the war. The Gate was designated as a county-level Ancient Monument by the Kaohsiung County Government in May, 2000.",
      "dateCreated": "2017-10-22 16:31:45",
      "sourceType": "commons-category",
      "sourceArticleId": "meinong-east-gate-tower-wp",
      "sourceGeohash4": "wsjd",
      "smallPath": "_m/w/s/j/d/meinong-east-gate-tower-wp/category-7-small.webp"
    },
