    {
      "filename": "瀰濃庄東門樓.jpg",
      "title": "File:瀰濃庄東門樓.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/5/50/%E7%80%B0%E6%BF%83%E5%BA%84%E6%9D%B1%E9%96%80%E6%A8%93.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:%E7%80%B0%E6%BF%83%E5%BA%84%E6%9D%B1%E9%96%80%E6%A8%93.jpg",
      "width": 3132,
      "height": 4036,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "WEI, WAN-CHEN（魏琬臻）",
      "description": "​瀰濃庄東門樓位於美濃永安路上，門樓緊依著美濃溪，溪水與門樓構成衛護昔日瀰濃庄聚落東側的防禦工事。東門樓創建年代相傳是瀰濃庄民於乾隆20年間(1755)將村落既有的東柵門改建而成，日治初期(1895~)，毀於六堆義民軍與日軍交戰的砲火中，直至昭和12年間(1937)才由鍾春發等鄉紳、耆老發起重建為樓高三層、鋼骨水泥的現在形式。太平洋戰爭時(1941〜1945)，上層增設小屋並掛大鐘以為防空警報。民國39年間(1950)，當地居民拆除小屋與大鐘，仿傳統城樓形式而重修為今日的樣貌。",
      "dateCreated": "2021-09-04 12:23:33",
      "sourceType": "commons-category",
      "sourceArticleId": "meinong-east-gate-tower-wp",
      "sourceGeohash4": "wsjd",
      "mediumPath": "_m/w/s/j/d/meinong-east-gate-tower-wp/category-9-medium.webp",
      "smallPath": "_m/w/s/j/d/meinong-east-gate-tower-wp/category-9-small.webp"
    },
