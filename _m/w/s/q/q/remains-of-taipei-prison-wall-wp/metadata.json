      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "氏子",
      "description": "Taipei Prison is a modern prison built by the Japanese people during the Japanese Colonial Rule in 1899～1904. The masonry of the wall was designed based on the modern prisons in Western countries. The stone of the demolished Tiapei City Walls in the Qing dynasty was resued to build the prison wall in order to reduce the construction cost.",
      "dateCreated": "2023-03-12 16:09:24",
      "sourceType": "commons-category",
      "sourceArticleId": "remains-of-taipei-prison-wall-wp",
      "sourceGeohash4": "wsqq",
