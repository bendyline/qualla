    {
      "filename": "Massive nuclear sunrise through ice clouds.jpg",
      "title": "File:Massive nuclear sunrise through ice clouds.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/aa/Massive_nuclear_sunrise_through_ice_clouds.jpg",
