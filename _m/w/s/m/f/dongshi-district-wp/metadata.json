      "sourceArticleId": "dongshi-district-wp",
      "sourceGeohash4": "wsmf",
      "mediumPath": "_m/w/s/m/f/dongshi-district-wp/massive-nuclear-sunrise-throug-medium.webp",
      "smallPath": "_m/w/s/m/f/dongshi-district-wp/massive-nuclear-sunrise-throug-small.webp"
