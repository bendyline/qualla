    {
      "filename": "Interior de las Chungking Mansions.jpg",
      "title": "File:Interior de las Chungking Mansions.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/4/48/Interior_de_las_Chungking_Mansions.jpg",
