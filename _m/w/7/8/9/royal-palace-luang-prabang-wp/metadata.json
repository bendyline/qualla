    },
    {
      "filename": "A frightful set of teeth! (14603448874).jpg",
      "title": "File:A frightful set of teeth! (14603448874).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/a2/A_frightful_set_of_teeth%21_%2814603448874%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:A_frightful_set_of_teeth!_(14603448874).jpg",
      "width": 4288,
      "height": 2848,
      "mime": "image/jpeg",
      "license": "CC BY 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/2.0",
      "artist": "shankar s. from Dubai, united arab emirates",
      "description": "A close-up of one of the formidable looking 'naga' heads at the end of the balustrade on the steps from a beautiful wat like building inside the gates of the LP National Museum. Now that's a frightful set of teeth! The single large canine is particularly unnerving. The sanctity of the naga theme in Laotian culture apart, this formidable creature is also believed to frighten away evil spirits visiting the wat. (Luang Prabang, Laos/ Lao PDR, April 2014)",
      "dateCreated": "2014-04-01 00:00",
      "sourceType": "commons-category",
      "sourceArticleId": "royal-palace-luang-prabang-wp",
      "sourceGeohash4": "w789",
      "mediumPath": "_m/w/7/8/9/royal-palace-luang-prabang-wp/a-frightful-set-of-teeth-14603-medium.webp",
      "smallPath": "_m/w/7/8/9/royal-palace-luang-prabang-wp/a-frightful-set-of-teeth-14603-small.webp"
    },
    {
      "filename": "Long shot of the main museum building (14582442616).jpg",
      "title": "File:Long shot of the main museum building (14582442616).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/16/Long_shot_of_the_main_museum_building_%2814582442616%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Long_shot_of_the_main_museum_building_(14582442616).jpg",
      "width": 4288,
      "height": 2848,
      "mime": "image/jpeg",
      "license": "CC BY 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/2.0",
      "artist": "shankar s. from Dubai, united arab emirates",
      "description": "A long shot of the LP Royal Palace, which is now the main display building of the LP National museum. I did go in there, but as with everywhere else in Laos, photography is strictly prohibited inside, and they make you check your camera in before you enter. And a large Nikon D90 dSLR is not something you can hide in your pocket! The no photo rule appeared to be strictly enforced as well, for apart from making you check in your camera, there are several volunteers inside keeping out an eagle eye for violators. (Luang Prabang, Laos/ Lao PDR, April 2014)",
      "dateCreated": "2014-04-01 00:00",
