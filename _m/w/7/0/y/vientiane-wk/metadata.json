    {
      "filename": "'Naga' themed balustrade ends (14339311358).jpg",
      "title": "File:'Naga' themed balustrade ends (14339311358).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/%27Naga%27_themed_balustrade_ends_%2814339311358%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:%27Naga%27_themed_balustrade_ends_(14339311358).jpg",
      "width": 4288,
      "height": 2848,
      "mime": "image/jpeg",
      "license": "CC BY 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/2.0",
      "artist": "shankar s. from Dubai, united arab emirates",
      "description": "As I bent down to put on my shoes, I could not help notice this pair of naga (serpent) themed balustrade ends. These are actuall the ends of the staircase railings on either side. This is another typically Laos thing, I saw similar naga (with formidable teeth) themed balustrade ends later on in Luang Prabang as well in the following days, some of them very colourful. (Vientaine, Laos/ Lao PDR, April 2014)",
      "dateCreated": "2014-04-01 00:00",
      "sourceType": "commons-category",
      "sourceArticleId": "vientiane-wk",
      "sourceGeohash4": "w70y"
    },
    {
      "filename": "Naga themed balustrade ends (14524848102).jpg",
      "title": "File:Naga themed balustrade ends (14524848102).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/17/Naga_themed_balustrade_ends_%2814524848102%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Naga_themed_balustrade_ends_(14524848102).jpg",
      "width": 4288,
      "height": 2848,
      "mime": "image/jpeg",
      "license": "CC BY 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/2.0",
      "artist": "shankar s. from Dubai, united arab emirates",
      "description": "Another look at the naga (snake) themed balustrade ends at the end of either staircase railing that you see after you descend the steps to the Haw Phra Kaew shrine in Vientaine, Laos. I saw several more of these in Luang Prabang in the coming days, some of them quite colourful. (Vientaine, Laos/ Lao PDR, April 2014)",
      "dateCreated": "2014-04-01 00:00",
      "sourceType": "commons-category",
      "sourceArticleId": "vientiane-wk",
      "sourceGeohash4": "w70y"
