      "filename": "Presidential Palace of Vietnam.jpg",
      "title": "File:Presidential Palace of Vietnam.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/f/f7/Presidential_Palace_of_Vietnam.jpg",
