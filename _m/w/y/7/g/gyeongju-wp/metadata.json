    {
      "filename": "Catholic Church Van (5285138974).jpg",
      "title": "File:Catholic Church Van (5285138974).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/9/9a/Catholic_Church_Van_%285285138974%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Catholic_Church_Van_(5285138974).jpg",
      "width": 800,
      "height": 600,
      "mime": "image/jpeg",
      "license": "CC BY-SA 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/2.0",
      "artist": "InSapphoWeTrust from Los Angeles, California, USA",
      "description": "Seen at the Bulguksa parking area.\nThis Hyundai Starex/H200 van belongs to a nearby Catholic cathedral. And sure enough, several uniformed nuns were touring the temple.\nSuch respectful coexistence of very different religions is the rule, rather than the exception, in East Asian nations, Korea being no exception. And I am doing my part myself - even as I madly visit Buddhist relics throughout Gyeongju and the rest of the country, I am playing Christmas carols in my rental car, which is absolutely typical in this part of the world.\n\nHowever, evangelical American-style Protestantism is resisting the trend, and the Protestant takeover of the national government and its anti-Buddhist bias were a major domestic political issue of 2008.",
      "dateCreated": "2008-11-17 11:27",
      "sourceType": "commons-category",
      "sourceArticleId": "gyeongju-wp",
      "sourceGeohash4": "wy7g",
      "smallPath": "_m/w/y/7/g/gyeongju-wp/catholic-church-van-5285138974-small.webp"
    },
