    {
      "filename": "Hiroshima after the bomb (6156141184).jpg",
      "title": "File:Hiroshima after the bomb (6156141184).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/f/f8/Hiroshima_after_the_bomb_%286156141184%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Hiroshima_after_the_bomb_(6156141184).jpg",
      "width": 3872,
      "height": 2592,
      "mime": "image/jpeg",
      "license": "CC BY 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/2.0",
      "artist": "Maarten Heerlien from Voorschoten, The Netherlands",
      "description": "This is a picture of a picture, taken at the Hiroshima Peace Memorial museum. It displays the complete destruction brought about by the atomic bomb on August 6 1945 at exactly 8:15 am. The building still somewhat standing is the Hiroshima Prefectural Industrial Promotion Hall, one of the very few structures that weren't completely obliterated. Designated a monument to the bombing the ruin still stands today and is known as the Genbaku (A-bomb) dome.",
      "dateCreated": "2009-09-10 15:10",
