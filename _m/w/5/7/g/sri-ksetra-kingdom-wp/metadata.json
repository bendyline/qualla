    {
      "filename": "Bawbawgyi Stupa.jpg",
      "title": "File:Bawbawgyi Stupa.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/a0/Bawbawgyi_Stupa.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Bawbawgyi_Stupa.jpg",
      "width": 5504,
      "height": 3096,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "Ninjastrikers",
      "description": "Bawbawgyi, one of the famous stupa in Sri Ksetra is situated in the southwestern part just outside of the city. The stupa is an elongated cylinder-shaped and originally solid type. It is known as one of nine merited stupas by King Duttabaung's establishment. The height of stupa is 153 feet.",
