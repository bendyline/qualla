    {
      "filename": "Lascar Mausoleum of Mao Zedong (4475525297).jpg",
      "title": "File:Lascar Mausoleum of Mao Zedong (4475525297).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/4/42/Lascar_Mausoleum_of_Mao_Zedong_%284475525297%29.jpg",
