    {
      "filename": "Lascar Wangfujing Cathedral (4498190780).jpg",
      "title": "File:Lascar Wangfujing Cathedral (4498190780).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/b/b6/Lascar_Wangfujing_Cathedral_%284498190780%29.jpg",
