    {
      "filename": "Outeniqua Transport Museum and Choo-Tjoe.JPG",
      "title": "File:Outeniqua Transport Museum and Choo-Tjoe.JPG",
      "url": "https://upload.wikimedia.org/wikipedia/commons/c/c1/Outeniqua_Transport_Museum_and_Choo-Tjoe.JPG",
