    {
      "filename": "Cape Agulhas, South Africa (ASTER).jpg",
      "title": "File:Cape Agulhas, South Africa (ASTER).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/5/55/Cape_Agulhas%2C_South_Africa_%28ASTER%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Cape_Agulhas,_South_Africa_(ASTER).jpg",
      "width": 2763,
      "height": 1493,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "NASA/METI/AIST/Japan Space Systems, and U.S./Japan ASTER Science Team",
      "description": "The southernmost tip of Africa is marked by the Cape Agulhas lighthouse. The cold Atlantic Benguela current meets the warm water Indian Ocean Agulhas current, creating treacherous seas that have claimed many ships over the last 450 years. The image covers the southern section of the Agulhas Plain and its inshore seas, an area of 22.5 by 41.1 kilometers. It was acquired September 27, 2006, and is located at 34.8 degrees south, 20 degrees east. In the midst of the image is Soetendalsvlei, a lake named for the Dutch ship Zoetendaal, which sank in the vicinity in 1673. Arniston, on the eastern limit of the picture is named for the demise of the Arniston in 1855. Other local shipwrecks include the Clan McGregor (1902) and Oriental Pioneer (1974).",
      "dateCreated": "Taken on 27 September 2006",
      "sourceType": "commons-category",
      "sourceArticleId": "agulhas-national-park-wk",
      "sourceGeohash4": "k3y1"
