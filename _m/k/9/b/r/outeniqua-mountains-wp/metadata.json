    {
      "filename": "ISS006-E-18959 - View of South Africa.jpg",
      "title": "File:ISS006-E-18959 - View of South Africa.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/f/f3/ISS006-E-18959_-_View_of_South_Africa.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:ISS006-E-18959_-_View_of_South_Africa.jpg",
      "width": 3032,
      "height": 2064,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "Earth Science and Remote Sensing Unit, Lyndon B. Johnson Space Center",
      "description": "View of South Africa taken during ISS Expedition 6, which shows the Garden Route District of the Western Cape, a province of South Africa. The view covers the region from about the hamlet of Vermaaklikheid at far left, to the city of George on the far right. George, Western Cape, is the second-largest city in the province and serves as the administrative and commercial hub for the Garden Route region. The green slopes of two major mountain ranges of the Cape Fold Belt are visible as a dark band dividing the landscape. These are the Langeberg at left, and the Outeniqua Mountains to the right. The region in their rain shadow is known as Cannaland, which constitutes the southwestern part of the Little Karoo. The Cannaland basin, eastern parts of the Langeberg and northern slopes of the Outeniqua are drained by the Gourits River and its numerous tributaries. The Gourits, a haven for native aquatic life, cuts through Die Poort, a defile in the Langeberg, to reach the Indian Ocean near Vleesbaai.",
      "dateCreated": "2003-01-12 10:37:48",
      "sourceType": "commons-category",
      "sourceArticleId": "langeberg-wp",
      "sourceGeohash4": "k9br"
    },
