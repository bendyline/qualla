    {
      "filename": "Oia, Santorini HDR sunset.jpg",
      "title": "File:Oia, Santorini HDR sunset.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/82/Oia%2C_Santorini_HDR_sunset.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Oia,_Santorini_HDR_sunset.jpg",
      "width": 1776,
      "height": 1178,
      "mime": "image/jpeg",
      "license": "CC BY-SA 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/2.0",
      "artist": "Pedro Szekely",
      "description": "Sunset in Oia, Santorini.\nHere is my version of the sunset shot in Oia. This is a blend of 3 shots, 1.3 to 20 seconds, processed as follows:\n1) Reduce noice on all 3 raws.\n2) Create HRD in Photomatix\n3) Blend using Exposure Fusion, sliders set to produce the most natural looking image while still showing some detail in the very dark areas.\n4) PS smart sharpen.\n5) PS burn the bottom\n6) Nik Brilliance and warming\n7) Nik Indian summer to warm th elights, masked to not affect the rest.\n8) Nik sunlight, brushed over the buildings to add more light\n9) Nik Glamour Glow to remove detail in the dark areas.\n10) Detailed curves lightening pn windmills.\n\n11) Dodge buildings that were too dark.",
      "dateCreated": "2012-06-01 11:10:17",
      "sourceType": "sibling",
      "sourceArticleId": "santorini-wk",
      "sourceGeohash4": "sw6p",
      "smallPath": "_m/s/w/6/p/santorini-wk/oia-santorini-hdr-sunset-small.jpg"
    },
