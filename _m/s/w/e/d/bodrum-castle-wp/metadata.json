    {
      "filename": "Bodrum Museum Carian Princess 3656.jpg",
      "title": "File:Bodrum Museum Carian Princess 3656.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/6/63/Bodrum_Museum_Carian_Princess_3656.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
