    {
      "filename": "Documenting excavations at Soba (Sudan).jpg",
      "title": "File:Documenting excavations at Soba (Sudan).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/8e/Documenting_excavations_at_Soba_%28Sudan%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Documenting_excavations_at_Soba_(Sudan).jpg",
      "width": 5472,
      "height": 3078,
      "mime": "image/jpeg",
      "license": "CC BY 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0",
      "artist": "Mariusz Drzewiecki",
      "description": "In Sudan, archaeologists arrive at work in the early morning. It is necessary to make photographic documentation before the Sun rises high. On the image, you can see archaeological trench, explored in November and December 2019. It is exposing mud-brick architecture. In medieval times the entire area, including the fields and the nearby orchards seen on the photo, was part of a large city, the capital of the kingdom of Alwa (Khartoum Province, Sudan).",
      "dateCreated": "2019-12-12 06:29:38",
