    {
      "filename": "Adana Yağ Camii Exterior Courtyard in 2008 58 3568.jpg",
      "title": "File:Adana Yağ Camii Exterior Courtyard in 2008 58 3568.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/b/b4/Adana_Ya%C4%9F_Camii_Exterior_Courtyard_in_2008_58_3568.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Adana_Ya%C4%9F_Camii_Exterior_Courtyard_in_2008_58_3568.jpg",
      "width": 4256,
      "height": 2832,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "Dosseman",
      "credit": "Own work",
      "source": "Adana Yağ Camii Exterior Courtyard in 2008 58 3568",
      "description": "The Yağ Camii or Oil Mosque is situated in a former church (but extended), as can be seen from the outside of its courtyard. Entrance to that courtyard is through a monumental gate, the mosque is opposite and to the right of the entrance. To the left of the entrance there is a medrese, other sides have facilities. It used to be an oasis of quiet in a busy neighbourhood, as the çarşı (markets- , shopping) area is around, and the street passing it has a continuous stream of dolmuses and other traffic. The mosque itself is plain. Due to restorations the complex looks brand new, but its well over half a millennium old. \nView from roughly in front of the medrese.",
      "dateCreated": "2008-09-07 11:57:16",
      "sourceType": "core",
      "sourceArticleId": "adana-wk",
      "sourceGeohash4": "sy94",
      "smallPath": "_m/s/y/9/4/adana-wk/yag-camii-oil-mosque-s-small.webp",
      "mediumPath": "_m/s/y/9/4/adana-wk/yag-camii-oil-mosque-s-medium.webp"
    },
    {
      "filename": "Adana Archaeological Museum Achilles' Sarcophagus 170-190 AD 0456.jpg",
      "title": "File:Adana Archaeological Museum Achilles' Sarcophagus 170-190 AD 0456.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/2/2d/Adana_Archaeological_Museum_Achilles%27_Sarcophagus_170-190_AD_0456.jpg",
