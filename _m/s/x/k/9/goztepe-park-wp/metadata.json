      "height": 5712,
      "mime": "image/jpeg",
      "license": "CC BY 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0",
      "artist": "YeditepeDogaSena",
      "description": "Büyük Çiçekli Manolya Levhası",
      "dateCreated": "2024-05-04 16:35:49",
