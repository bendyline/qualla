    {
      "filename": "Molla Zeyrek Mosque13.jpg",
      "title": "File:Molla Zeyrek Mosque13.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/5/5b/Molla_Zeyrek_Mosque13.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Molla_Zeyrek_Mosque13.jpg",
      "width": 1600,
      "height": 1200,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "Klcemirhan",
      "description": "The mosque is the churches of the Pantokrator Monastery belonging to the Byzantine period and was built on a large terrain with terraces on a hill overlooking the Golden Horn. The building, which was built by Eirene, wife of the Emperor Il. loannis Komnenos (1111-1143), the daughter of Hungarian King Laszlo, is estimated to have been completed by her husband after the death of the empress in 1124. The architect of the buildings is known as Nikeforos. The monastery had a fifty-bed hospital with five divisions, a library, a home for the elderly, a medical school, a pharmacy and holy spring. The monastery, which was converted into a madrasa after the conquest of Sultan Mehmed the Conqueror, became the first educational institution of Istanbul in the Ottoman period.",
      "dateCreated": "2022-04-18",
      "sourceType": "commons-category",
      "sourceArticleId": "zeyrek-mosque-wp",
      "sourceGeohash4": "sxk9",
      "smallPath": "_m/s/x/k/9/zeyrek-mosque-wp/molla-zeyrek-mosque13-small.webp"
    },
