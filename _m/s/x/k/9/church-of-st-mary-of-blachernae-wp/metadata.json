    {
      "filename": "Saint Mary of Blachernae 8935.jpg",
      "title": "File:Saint Mary of Blachernae 8935.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/9/95/Saint_Mary_of_Blachernae_8935.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Saint_Mary_of_Blachernae_8935.jpg",
      "width": 2848,
