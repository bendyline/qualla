    {
      "filename": "Bulgaria-02860 - Church of St George (11045756866).jpg",
      "title": "File:Bulgaria-02860 - Church of St George (11045756866).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/15/Bulgaria-02860_-_Church_of_St_George_%2811045756866%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
