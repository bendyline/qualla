    {
      "filename": "Bujjabukula, The guard house.jpg",
      "title": "File:Bujjabukula, The guard house.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/a6/Bujjabukula%2C_The_guard_house.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Bujjabukula,_The_guard_house.jpg",
      "width": 3024,
      "height": 4032,
      "mime": "image/jpeg",
      "license": "CC BY-SA 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0",
      "artist": "Jim Joel",
      "description": "The gatehouse is the official entrance to Kasubi tombs, it was built with reeds and spear grass in 1880. This is where Kabaka Muteesa 1 of Buganda lived from 1880 to 1882 while awaiting completion of the main house in Kampala.",
