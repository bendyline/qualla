    {
      "filename": "Leptis.jpg",
      "title": "File:Leptis.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Leptis.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Leptis.jpg",
      "width": 5472,
      "height": 3648,
