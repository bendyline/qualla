      "description": "Script\nxmin=350\nxmax=375\nymin=7640\nymax=7670\nfile='piton_de_la_fournaise_run.sh'\noutput=\"piton.jpg\"\necho \"magick\" \"\\\\\" &gt; $file\nfor y in `seq -f %04.f $ymax -5 $ymin` ; do\n\n   echo \"\\\\(\" \"\\\\\" &gt;&gt; $file \n   for x in `seq  -f %04.f $xmin 5 $xmax` ; do\n\n\tin=BDORTHO_2-0_RVB-0M20_JP2-E080_RGR92UTM40S_D974_2022-01-01/ORTHOHR/1_DONNEES_LIVRAISON_2024-03-00066/OHR_RVB_0M20_JP2-E080_RGR92UTM40S_D974-2022/974-2022-$x-$y-U40S-0M20-E080.jp2\n\n       if [ -f $in ];\n\n\tthen\t\n\t  echo \"\\\\(\" \"\\\\\" &gt;&gt; $file \n\n\t  echo $in \"\\\\\" &gt;&gt; $file\n\n\t  echo \"-resize 20%\" \"\\\\)\" \"\\\\\" &gt;&gt; $file\n\tfi\n\n   done\n   echo \"+append\" \"\\\\)\" \"\\\\\" &gt;&gt; $file \n\ndone\n\necho \"-append\" $output &gt;&gt; $file",
