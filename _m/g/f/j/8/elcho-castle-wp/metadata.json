    {
      "filename": "Elcho Castle - geograph.org.uk - 1286467.jpg",
      "title": "File:Elcho Castle - geograph.org.uk - 1286467.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/b/ba/Elcho_Castle_-_geograph.org.uk_-_1286467.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Elcho_Castle_-_geograph.org.uk_-_1286467.jpg",
      "width": 480,
      "height": 640,
      "mime": "image/jpeg",
      "license": "CC BY-SA 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/2.0",
      "artist": "ronnie leask",
      "description": "Elcho Castle Now in the care of Historic Scotland this large 4 storey castle dates from the 16th century and was a seat of the Earl of Wemyss. The heir to the earldom taking the title Lord Elcho. During the 1745 Rising Lord Elcho was Master of  Horse in Bonnie Prince Charlie's army. The castle is roofed and in excellent condition, although not furnished, and amongst other features has a number of splayed gunloops. View is over the orchard and picnic area.",
      "dateCreated": "2009-04-28",
      "sourceType": "commons-category",
      "sourceArticleId": "elcho-castle-wp",
      "sourceGeohash4": "gfj8"
    },
    {
      "filename": "Elcho Castle - geograph.org.uk - 1286559.jpg",
      "title": "File:Elcho Castle - geograph.org.uk - 1286559.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/d7/Elcho_Castle_-_geograph.org.uk_-_1286559.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Elcho_Castle_-_geograph.org.uk_-_1286559.jpg",
      "width": 480,
      "height": 640,
      "mime": "image/jpeg",
      "license": "CC BY-SA 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/2.0",
      "artist": "ronnie leask",
      "description": "Elcho Castle Built in the late 16th century for the Earl of Wemyss this large castle is now in the care of Historic Scotland. It has four towers with wallhead walks giving clear views of anyone approaching. For further defence there are no fewer than 17 splayed gunloops in the basement. The southern aspect is bright with many large windows whereas the rear north wall as shown in the photo has few windows. It is thought much of the stone for its building was quarried from this area which now serves as a wild shrub garden.",
      "dateCreated": "2009-04-28",
      "sourceType": "commons-category",
      "sourceArticleId": "elcho-castle-wp",
      "sourceGeohash4": "gfj8"
