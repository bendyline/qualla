      "licenseUrl": "https://creativecommons.org/licenses/by-sa/2.0",
      "artist": "John Allan",
      "description": "View from Trumpan Church Looking up the west coast of Waternish Point towards Rubha Dubh.",
      "dateCreated": "2008-11-12",
      "sourceType": "commons-category",
