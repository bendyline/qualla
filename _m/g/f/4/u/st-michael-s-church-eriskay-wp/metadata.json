    },
    {
      "filename": "The Altar of St Michael's of the Sea - geograph.org.uk - 1357183.jpg",
      "title": "File:The Altar of St Michael's of the Sea - geograph.org.uk - 1357183.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/1a/The_Altar_of_St_Michael%27s_of_the_Sea_-_geograph.org.uk_-_1357183.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:The_Altar_of_St_Michael%27s_of_the_Sea_-_geograph.org.uk_-_1357183.jpg",
      "width": 640,
      "height": 505,
      "mime": "image/jpeg",
      "license": "CC BY-SA 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/2.0",
      "artist": "Barbara Carr",
      "description": "The Altar of St Michael's of the Sea. St Michael's was opened in 1903, but has since been renovated.  This unique altar-piece reflects Eriskay's links with the sea, being the bow of a lifeboat from HMS Hermes.  While the ship was engaged in exercises off St Kilda, the lifeboat was swept overboard and eventually washed up at Pollachar, about 4.5km to the northwest of Haun - it was damaged, but the bow section was sound enough to be recovered and installed here at St Michael's.  See 1357166.",
      "dateCreated": "2009-06-10",
      "sourceType": "commons-category",
      "sourceArticleId": "st-michael-s-church-eriskay-wp",
      "sourceGeohash4": "gf4u",
      "smallPath": "_m/g/f/4/u/st-michael-s-church-eriskay-wp/the-altar-of-st-michael-s-of-t-small.webp"
    },
    {
      "filename": "The Church of St Michael's of the Sea - geograph.org.uk - 1357166.jpg",
      "title": "File:The Church of St Michael's of the Sea - geograph.org.uk - 1357166.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/2/2f/The_Church_of_St_Michael%27s_of_the_Sea_-_geograph.org.uk_-_1357166.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:The_Church_of_St_Michael%27s_of_the_Sea_-_geograph.org.uk_-_1357166.jpg",
      "width": 640,
      "height": 453,
      "mime": "image/jpeg",
      "license": "CC BY-SA 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/2.0",
      "artist": "Barbara Carr",
      "description": "The Church of St Michael's of the Sea. The Roman Catholic Church at Haun was opened in 1903.  The bell at the gate was recovered from the German battleship \"Derfflinger\" see 1357173, which sunk at Scapa Flow.  The altar of the church is the bow of a lifeboat from HMS Hermes 1357183.  See also 1357198 and 1357187.",
      "dateCreated": "2009-06-10",
