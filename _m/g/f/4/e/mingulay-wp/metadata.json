    {
      "filename": "Bàgh Mhiùghlaigh and site of village - geograph.org.uk - 1290935.jpg",
      "title": "File:Bàgh Mhiùghlaigh and site of village - geograph.org.uk - 1290935.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/df/B%C3%A0gh_Mhi%C3%B9ghlaigh_and_site_of_village_-_geograph.org.uk_-_1290935.jpg",
