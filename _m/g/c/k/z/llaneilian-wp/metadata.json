    {
      "filename": "Bythynod Llanfoi Cottages, Llaneilian - geograph.org.uk - 1408732.jpg",
      "title": "File:Bythynod Llanfoi Cottages, Llaneilian - geograph.org.uk - 1408732.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/1f/Bythynod_Llanfoi_Cottages%2C_Llaneilian_-_geograph.org.uk_-_1408732.jpg",
