    {
      "filename": "Guests of the Pilot - geograph.org.uk - 245443.jpg",
      "title": "File:Guests of the Pilot - geograph.org.uk - 245443.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/2/28/Guests_of_the_Pilot_-_geograph.org.uk_-_245443.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Guests_of_the_Pilot_-_geograph.org.uk_-_245443.jpg",
      "width": 640,
      "height": 480,
      "mime": "image/jpeg",
      "license": "CC BY-SA 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/2.0",
      "artist": "Eric Jones",
      "description": "Guests of the Pilot. Visitors to Caernarfon Airport are sometimes invited by the pilot to have a closer look at the Air Ambulance. This is one of three such helicopter ambulances operating in Wales, and is a familiar sight in the skies of North Wales. It is distinguishable from most other helicopters by its speed, engine noise and red colour. The service started in July 2003, operates during daylight hours 7 days a week. When not airbourne the ambulance is on 5 minute stand-by at Caernarfon Airport (former RAF Llandwrog). The service, though costly, is a God-send in a region where terrestrial ambulances can take an hour or more to reach one of the regional hospitals.\nThis helicopter is a Bolkow-105 DBS",
      "dateCreated": "2006-09-22",
      "sourceType": "commons-category",
      "sourceArticleId": "dinas-dinlle-wp",
      "sourceGeohash4": "gcky"
    },
