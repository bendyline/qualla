    {
      "filename": "The central chamber of the Barclodiad-y-Gawres tomb - geograph.org.uk - 1059446.jpg",
      "title": "File:The central chamber of the Barclodiad-y-Gawres tomb - geograph.org.uk - 1059446.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/82/The_central_chamber_of_the_Barclodiad-y-Gawres_tomb_-_geograph.org.uk_-_1059446.jpg",
