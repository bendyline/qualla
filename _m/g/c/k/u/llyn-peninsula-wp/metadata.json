    {
      "filename": "Taith Gerdded Brotest - Protest March - geograph.org.uk - 691561.jpg",
      "title": "File:Taith Gerdded Brotest - Protest March - geograph.org.uk - 691561.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/0/0c/Taith_Gerdded_Brotest_-_Protest_March_-_geograph.org.uk_-_691561.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Taith_Gerdded_Brotest_-_Protest_March_-_geograph.org.uk_-_691561.jpg",
