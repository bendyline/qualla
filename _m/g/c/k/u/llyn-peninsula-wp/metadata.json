    {
      "filename": "Aberdaron - Traeth-Beach - geograph.org.uk - 1614429.jpg",
      "title": "File:Aberdaron - Traeth-Beach - geograph.org.uk - 1614429.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/e/e7/Aberdaron_-_Traeth-Beach_-_geograph.org.uk_-_1614429.jpg",
