    {
      "filename": "Cathedral Church of St Colman - DPLA - 80a9fd64b7531b5f4000503aaf7d4f86.jpg",
      "title": "File:Cathedral Church of St Colman - DPLA - 80a9fd64b7531b5f4000503aaf7d4f86.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/7/7f/Cathedral_Church_of_St_Colman_-_DPLA_-_80a9fd64b7531b5f4000503aaf7d4f86.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Cathedral_Church_of_St_Colman_-_DPLA_-_80a9fd64b7531b5f4000503aaf7d4f86.jpg",
      "width": 4594,
