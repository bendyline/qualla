      "filename": "Daniel Doyle Sand Sculpture.jpg",
      "title": "File:Daniel Doyle Sand Sculpture.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/dd/Daniel_Doyle_Sand_Sculpture.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Daniel_Doyle_Sand_Sculpture.jpg",
