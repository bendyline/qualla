    {
      "filename": "Charles Fort - Kinsale -Married Quarters - geograph.org.uk - 1391181.jpg",
      "title": "File:Charles Fort - Kinsale -Married Quarters - geograph.org.uk - 1391181.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/e/e4/Charles_Fort_-_Kinsale_-Married_Quarters_-_geograph.org.uk_-_1391181.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Charles_Fort_-_Kinsale_-Married_Quarters_-_geograph.org.uk_-_1391181.jpg",
