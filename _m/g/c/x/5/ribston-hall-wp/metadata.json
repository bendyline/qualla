    {
      "filename": "Ribston Hall, north east front - geograph.org.uk - 1088095.jpg",
      "title": "File:Ribston Hall, north east front - geograph.org.uk - 1088095.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/84/Ribston_Hall%2C_north_east_front_-_geograph.org.uk_-_1088095.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Ribston_Hall,_north_east_front_-_geograph.org.uk_-_1088095.jpg",
