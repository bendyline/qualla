    {
      "filename": "Hartlepool - The Heugh Lighthouse (geograph 7379083).jpg",
      "title": "File:Hartlepool - The Heugh Lighthouse (geograph 7379083).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/ab/Hartlepool_-_The_Heugh_Lighthouse_%28geograph_7379083%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Hartlepool_-_The_Heugh_Lighthouse_(geograph_7379083).jpg",
      "width": 5184,
      "height": 2912,
      "mime": "image/jpeg",
      "license": "CC BY-SA 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/2.0",
      "artist": "Colin Park",
      "credit": "From geograph.org.uk",
      "source": "Hartlepool - The Heugh Lighthouse (geograph 7379083)",
      "description": "Established in 1847, the original Heugh Lighthouse was the first to be powered by natural gas produced from local coal mines. It displayed a subsidiary red light lower down the tower depending on the state of the tide. It was demolished in 1915 as it obstructed the line of fire from the headland battery. A temporary wooden lattice tower was erected on the Town Moor and the lantern and lens from the lighthouse were relocated to the new tower. The current lighthouse replaced the lattice tower in 1927 and is 13 metres high.",
      "dateCreated": "2022-08-08",
      "sourceType": "core",
      "sourceArticleId": "hartlepool-wp",
      "sourceGeohash4": "gcxp",
      "mediumPath": "_m/g/c/x/p/hartlepool-wp/established-1847-origi-medium.webp",
