    {
      "filename": "Michael and Christine Egan Memorials, Kingston upon Hull Dec23.jpg",
      "title": "File:Michael and Christine Egan Memorials, Kingston upon Hull Dec23.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/9/9b/Michael_and_Christine_Egan_Memorials%2C_Kingston_upon_Hull_Dec23.jpg",
