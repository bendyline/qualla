    {
      "filename": "Plaque in a tree - geograph.org.uk - 895812.jpg",
      "title": "File:Plaque in a tree - geograph.org.uk - 895812.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/0/02/Plaque_in_a_tree_-_geograph.org.uk_-_895812.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Plaque_in_a_tree_-_geograph.org.uk_-_895812.jpg",
