    {
      "filename": "Victoria Theatre, Halifax - geograph.org.uk - 1216474.jpg",
      "title": "File:Victoria Theatre, Halifax - geograph.org.uk - 1216474.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/e/e4/Victoria_Theatre%2C_Halifax_-_geograph.org.uk_-_1216474.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Victoria_Theatre,_Halifax_-_geograph.org.uk_-_1216474.jpg",
      "width": 640,
