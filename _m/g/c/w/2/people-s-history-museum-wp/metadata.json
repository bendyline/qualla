    {
      "filename": "Farnworth and Kearsley Reform Club c.1884 Handkerchief.jpg",
      "title": "File:Farnworth and Kearsley Reform Club c.1884 Handkerchief.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/b/b9/Farnworth_and_Kearsley_Reform_Club_c.1884_Handkerchief.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Farnworth_and_Kearsley_Reform_Club_c.1884_Handkerchief.jpg",
      "width": 4262,
      "height": 2941,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "People's History Museum",
      "description": "In 1884, William Gladstone passed the Reform Act which extended the Reform Act of 1867.  All men paying rent or owning property valued at £10 were now able to vote. This resulted in ‘one man one vote’. There were also boundary changes so that there was 1 MP per constituency. \n40% of men and all women were still without the vote. This led to women’s suffrage groups starting to be established. The National Union of Women’s Suffrage Societies was founded in 1897.  \n\nThis handkerchief was presented to Gladstone in 1884 by the Farnworth and Kearsley Reform Club.",
      "dateCreated": "1884",
      "sourceType": "commons-category",
      "sourceArticleId": "people-s-history-museum-wp",
      "sourceGeohash4": "gcw2"
    },
