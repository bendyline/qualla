    {
      "filename": "Scotia's Grave - geograph.org.uk - 1404461.jpg",
      "title": "File:Scotia's Grave - geograph.org.uk - 1404461.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/2/20/Scotia%27s_Grave_-_geograph.org.uk_-_1404461.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
