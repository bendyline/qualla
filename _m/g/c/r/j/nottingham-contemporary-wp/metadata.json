    {
      "filename": "High Pavement on a misty morning - geograph.org.uk - 2060538.jpg",
      "title": "File:High Pavement on a misty morning - geograph.org.uk - 2060538.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/a9/High_Pavement_on_a_misty_morning_-_geograph.org.uk_-_2060538.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:High_Pavement_on_a_misty_morning_-_geograph.org.uk_-_2060538.jpg",
