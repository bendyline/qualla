    {
      "filename": "Bunhill Fields Burial Ground - geograph.org.uk - 1036826.jpg",
      "title": "File:Bunhill Fields Burial Ground - geograph.org.uk - 1036826.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/11/Bunhill_Fields_Burial_Ground_-_geograph.org.uk_-_1036826.jpg",
