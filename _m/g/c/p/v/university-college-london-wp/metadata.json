    {
      "filename": "Art and maths workshop (13536517364).jpg",
      "title": "File:Art and maths workshop (13536517364).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/84/Art_and_maths_workshop_%2813536517364%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Art_and_maths_workshop_(13536517364).jpg",
      "width": 1280,
      "height": 853,
      "mime": "image/jpeg",
      "license": "CC BY 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/2.0",
      "artist": "UCL Mathematical &amp; Physical Sciences from London, UK",
      "description": "Jason Lotay (UCL Maths) and Lilah Fowler (UCL Slade School of Fine Art) recently held a public workshop on maths and art, exploring the geometry of 4 dimensions through drawing, folding and making shapes.\nBy combining practical activities with the presentation, Lotay and Fowler created fascinating objects and understood their role in cutting-edge mathematics.\nLotay gave the interactive maths presentation, which involved many pictures, animations and videos, and described a number of aspects of geometry, relating it to the everyday, science, popular culture, literature and art. He also described aspects of his own research and advances at the forefront of modern mathematics. \nFowler led the practical activities including drawing, folding paper to make an artwork which appears in her own work, and a final making activity to realise an object that comes from 4 dimensions and which is relevant to Lotay's research.\n\nPhoto credit: UCL",
      "dateCreated": "2014-03-21 19:54",
      "sourceType": "commons-category",
      "sourceArticleId": "university-college-london-wp",
      "sourceGeohash4": "gcpv"
    },
