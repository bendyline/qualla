    {
      "filename": "Eagle sculpture, Naval Support Activity Naples.jpg",
      "title": "File:Eagle sculpture, Naval Support Activity Naples.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/5/5f/Eagle_sculpture%2C_Naval_Support_Activity_Naples.jpg",
