    {
      "filename": "Ardrossan Castle - Satan's hoof print - geograph.org.uk - 1166176.jpg",
      "title": "File:Ardrossan Castle - Satan's hoof print - geograph.org.uk - 1166176.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/a6/Ardrossan_Castle_-_Satan%27s_hoof_print_-_geograph.org.uk_-_1166176.jpg",
