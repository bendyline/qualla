    {
      "filename": "Flame structure at Lochranza harbour - geograph.org.uk - 1158903.jpg",
      "title": "File:Flame structure at Lochranza harbour - geograph.org.uk - 1158903.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/ae/Flame_structure_at_Lochranza_harbour_-_geograph.org.uk_-_1158903.jpg",
