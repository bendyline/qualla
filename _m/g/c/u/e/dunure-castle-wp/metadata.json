    {
      "filename": "Where The Commendator Was Roasted - geograph.org.uk - 1306407.jpg",
      "title": "File:Where The Commendator Was Roasted - geograph.org.uk - 1306407.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/e/e8/Where_The_Commendator_Was_Roasted_-_geograph.org.uk_-_1306407.jpg",
