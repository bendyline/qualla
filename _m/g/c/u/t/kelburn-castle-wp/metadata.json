    {
      "filename": "The Kel Burn - geograph.org.uk - 987593.jpg",
      "title": "File:The Kel Burn - geograph.org.uk - 987593.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/5/50/The_Kel_Burn_-_geograph.org.uk_-_987593.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:The_Kel_Burn_-_geograph.org.uk_-_987593.jpg",
      "width": 640,
