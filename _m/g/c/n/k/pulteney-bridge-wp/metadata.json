    {
      "filename": "Bath - Pulteney Bridge.jpg",
      "title": "File:Bath - Pulteney Bridge.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/5/51/Bath_-_Pulteney_Bridge.jpg",
