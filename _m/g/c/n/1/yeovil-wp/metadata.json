      "filename": "Yeovil banner Fleet Air Arm Museum.jpg",
      "title": "File:Yeovil banner Fleet Air Arm Museum.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/6/69/Yeovil_banner_Fleet_Air_Arm_Museum.jpg",
