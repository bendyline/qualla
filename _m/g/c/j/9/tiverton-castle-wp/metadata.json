    {
      "filename": "GiffardMonumentTivertonChurch.JPG",
      "title": "File:GiffardMonumentTivertonChurch.JPG",
      "url": "https://upload.wikimedia.org/wikipedia/commons/2/2a/GiffardMonumentTivertonChurch.JPG",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:GiffardMonumentTivertonChurch.JPG",
      "width": 2029,
      "height": 3518,
      "mime": "image/jpeg",
      "license": "Public domain",
      "artist": "own photo",
      "description": "Mural monument to Roger Giffard (d.1603) of Tiverton Castle, north chancel wall, Tiverton Church, Devon. Arms, quarterly of four: 1st: Giffard of Brightley; 2nd: Coblegh of Brightley; 3rd: Stucley of Affeton; 4th: ? Cornu or Hawley (three hunting horns stringed) (per Pole)",
      "dateCreated": "2012",
      "sourceType": "commons-category",
      "sourceArticleId": "tiverton-castle-wp",
      "sourceGeohash4": "gcj9",
      "mediumPath": "_m/g/c/j/9/tiverton-castle-wp/giffardmonumenttivertonchurch-medium.webp",
