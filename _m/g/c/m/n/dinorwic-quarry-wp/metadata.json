    {
      "filename": "A1 Drum-House - geograph.org.uk - 283821.jpg",
      "title": "File:A1 Drum-House - geograph.org.uk - 283821.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/85/A1_Drum-House_-_geograph.org.uk_-_283821.jpg",
