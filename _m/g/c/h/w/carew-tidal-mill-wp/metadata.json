    {
      "filename": "Carew Tidal Mill - geograph.org.uk - 13991.jpg",
      "title": "File:Carew Tidal Mill - geograph.org.uk - 13991.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/6/63/Carew_Tidal_Mill_-_geograph.org.uk_-_13991.jpg",
