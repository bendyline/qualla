    {
      "filename": "Behind bars - Swiss Valley School - geograph.org.uk - 945648.jpg",
      "title": "File:Behind bars - Swiss Valley School - geograph.org.uk - 945648.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/a/a6/Behind_bars_-_Swiss_Valley_School_-_geograph.org.uk_-_945648.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Behind_bars_-_Swiss_Valley_School_-_geograph.org.uk_-_945648.jpg",
      "width": 640,
      "height": 480,
      "mime": "image/jpeg",
      "license": "CC BY-SA 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/2.0",
      "artist": "Deborah Tilley",
      "description": "Behind bars - Swiss Valley School Built in 1970, replacing the old infant and junior schools in Felinfoel. It is in an amazing position with panoramic views sweeping east to west. The nearest building is an extension that did not exist when I was a pupil - we did have a portable cabin though, but it soon became evident that that wouldn't be sufficient for this popular, ever expanding school.\nMr Lewis was the headmaster, Mr Stan Phillips the deputy and some of the other lovely teachers when I was there were Miss Howells and Mr Morgan.\n\nI would have liked to take more photos but in these times I decided it may not be wise to be seen taking photos of a school!",
      "dateCreated": "2008-08-31",
      "sourceType": "commons-category",
      "sourceArticleId": "carmarthenshire-wp",
      "sourceGeohash4": "gchz",
      "smallPath": "_m/g/c/h/z/carmarthenshire-wp/behind-bars-swiss-valley-schoo-small.webp"
    },
