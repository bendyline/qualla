      "filename": "Staigue Fort - geograph.org.uk - 769902.jpg",
      "title": "File:Staigue Fort - geograph.org.uk - 769902.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/8c/Staigue_Fort_-_geograph.org.uk_-_769902.jpg",
