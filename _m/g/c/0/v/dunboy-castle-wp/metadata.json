      "filename": "Dunboy Castle - geograph.org.uk - 499447.jpg",
      "title": "File:Dunboy Castle - geograph.org.uk - 499447.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/81/Dunboy_Castle_-_geograph.org.uk_-_499447.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Dunboy_Castle_-_geograph.org.uk_-_499447.jpg",
      "width": 1024,
