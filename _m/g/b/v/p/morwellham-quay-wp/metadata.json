    {
      "filename": "Gulworthy, waterwheel at Morwellham - geograph.org.uk - 415329.jpg",
      "title": "File:Gulworthy, waterwheel at Morwellham - geograph.org.uk - 415329.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/1/19/Gulworthy%2C_waterwheel_at_Morwellham_-_geograph.org.uk_-_415329.jpg",
