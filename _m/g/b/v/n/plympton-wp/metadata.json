    {
      "filename": "Drake Memorial Park - geograph.org.uk - 1557031.jpg",
      "title": "File:Drake Memorial Park - geograph.org.uk - 1557031.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/f/f4/Drake_Memorial_Park_-_geograph.org.uk_-_1557031.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
