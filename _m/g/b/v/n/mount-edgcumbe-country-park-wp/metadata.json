      "sourceGeohash4": "gbvn"
    },
    {
      "filename": "Camellias behind Mount Edgcumbe House - geograph.org.uk - 347649.jpg",
      "title": "File:Camellias behind Mount Edgcumbe House - geograph.org.uk - 347649.jpg",
