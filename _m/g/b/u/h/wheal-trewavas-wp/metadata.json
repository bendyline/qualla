    {
      "filename": "Trewavas Mine buildings - geograph.org.uk - 1109983.jpg",
      "title": "File:Trewavas Mine buildings - geograph.org.uk - 1109983.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/8/82/Trewavas_Mine_buildings_-_geograph.org.uk_-_1109983.jpg",
