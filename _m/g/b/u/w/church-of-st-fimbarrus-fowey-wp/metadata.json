    {
      "filename": "Place, Place Road, Fowey - geograph.org.uk - 661246.jpg",
      "title": "File:Place, Place Road, Fowey - geograph.org.uk - 661246.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/b/bd/Place%2C_Place_Road%2C_Fowey_-_geograph.org.uk_-_661246.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Place,_Place_Road,_Fowey_-_geograph.org.uk_-_661246.jpg",
