    {
      "filename": "Lower Old Lighthouse. Portland Bill. Dorset. (4793118080).jpg",
      "title": "File:Lower Old Lighthouse. Portland Bill. Dorset. (4793118080).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/7/74/Lower_Old_Lighthouse._Portland_Bill._Dorset._%284793118080%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Lower_Old_Lighthouse._Portland_Bill._Dorset._(4793118080).jpg",
