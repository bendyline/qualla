    {
      "filename": "Ingolf by Raadsig.jpg",
      "title": "File:Ingolf by Raadsig.jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/2/25/Ingolf_by_Raadsig.jpg",
