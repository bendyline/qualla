      "width": 6000,
      "height": 4000,
      "mime": "image/jpeg",
      "license": "CC BY-SA 2.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/2.0",
      "artist": "Dennis G. Jarvis",
      "description": "Entrance to the Fairmont Le Château Montebello or simply Château Montebello, it is a hotel and resort complex in Montebello, Quebec. The retreat is set in 26,305 hectares (65,000 acres) of a forested wildlife sanctuary and 70 lakes on the shore of the Ottawa River. It is the largest log building in the world.",
      "dateCreated": "Taken on 24 August 2018, 07:41",
      "sourceType": "commons-category",
      "sourceArticleId": "ch-teau-montebello-wp",
      "sourceGeohash4": "f24e",
