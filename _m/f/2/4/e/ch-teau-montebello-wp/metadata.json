    {
      "filename": "DSC02818 - Entrance to Château Montebello (31020705498).jpg",
      "title": "File:DSC02818 - Entrance to Château Montebello (31020705498).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/d/d2/DSC02818_-_Entrance_to_Ch%C3%A2teau_Montebello_%2831020705498%29.jpg",
