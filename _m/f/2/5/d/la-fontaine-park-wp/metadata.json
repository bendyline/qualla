    {
      "filename": "Montréal 1869. La Ferme Logan. (6443321161).jpg",
      "title": "File:Montréal 1869. La Ferme Logan. (6443321161).jpg",
      "url": "https://upload.wikimedia.org/wikipedia/commons/2/26/Montr%C3%A9al_1869._La_Ferme_Logan._%286443321161%29.jpg",
      "descriptionUrl": "https://commons.wikimedia.org/wiki/File:Montr%C3%A9al_1869._La_Ferme_Logan._(6443321161).jpg",
      "width": 3648,
